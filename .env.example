PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PUBLIC_SITE_URL=http://localhost:4321

# Super admin is always onezcodes@gmail.com (Google). That account manages the team whitelist in /team/members.

# Invitation and contact-form emails (Resend). Verify a domain, then set MAIL_FROM to that domain.
# Until then Resend only delivers to the account inbox if you keep onboarding@resend.dev.
RESEND_API_KEY=
MAIL_FROM=Onez Codes <onboarding@resend.dev>

# Encrypts shared credential secrets at rest. Generate with: openssl rand -hex 32
CREDENTIALS_SECRET=

# Optional. Vercel Cron sends Authorization: Bearer $CRON_SECRET. Service role lets due-mail run when nobody is signed in.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

