---
import '@fontsource-variable/outfit/wght.css';
import '../styles/global.css';
import logo from '../assets/logo.webp';
import { site } from '../data/site';
import { emailOf, isSuperAdmin } from '../lib/supabase';
import NavChrome from '../components/NavChrome.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const email = emailOf(user);
const admin = isSuperAdmin(user);
const studio = Astro.locals.studio;
const canLedger = studio?.canLedger ?? admin;
const canVault = studio?.canVault ?? admin;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/team';
const pageTitle = `${title} · Team · ${site.name}`;
const label = studio?.displayName || email;

const links = [
  { href: '/team', label: 'Overview' },
  { href: '/team/projects', label: 'Projects' },
  ...(canLedger ? [{ href: '/team/ledger', label: 'Ledger' }] : []),
  ...(canVault ? [{ href: '/team/credentials', label: 'Credentials' }] : []),
  { href: '/team/activity', label: 'Activity' },
  ...(admin ? [{ href: '/team/members', label: 'Team' }] : []),
];

function current(href: string) {
  if (href === '/team') return path === '/team';
  return path === href || path.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FAFAF8" />
    <meta name="color-scheme" content="light" />
    <NavChrome />
  </head>
  <body class="team-body">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner team-header">
        <a class="brand" href="/team" data-astro-prefetch="hover">
          <img src={logo.src} alt="" width="40" height="40" />
          <span class="brand-name">
            <strong>Team</strong>
            <span>{site.name}</span>
          </span>
        </a>
        <button
          class="menu-toggle"
          id="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-panel"
        >
          <span class="sr-only">Menu</span>
          <span class="menu-toggle-bars" aria-hidden="true"></span>
        </button>
        <div class="nav-panel" id="nav-panel">
          <nav aria-label="Team">
            <ul class="nav-links team-nav">
              {
                links.map((item) => (
                  <li>
                    <a href={item.href} data-astro-prefetch="hover" aria-current={current(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="team-user">
            {
              email && (
                <a class="team-profile" href="/team/profile" data-astro-prefetch="hover" aria-current={path === '/team/profile' ? 'page' : undefined}>
                  {studio?.avatarUrl ? (
                    <img class="team-avatar" src={studio.avatarUrl} alt="" width="32" height="32" />
                  ) : (
                    <span class="team-avatar team-avatar-fallback" aria-hidden="true">
                      {label.slice(0, 1).toUpperCase()}
                    </span>
                  )}
                  <span>
                    <strong>{label}</strong>
                    <span>{studio?.jobTitle || email}</span>
                  </span>
                </a>
              )
            }
            <form method="post" action="/auth/logout" data-astro-reload>
              <button class="btn btn-ghost" type="submit">Sign out</button>
            </form>
          </div>
        </div>
      </div>
    </header>
    <main id="main" class="team-main">
      <slot />
    </main>
    <footer class="team-foot wrap">
      <a href="/">Public site</a>
    </footer>
    <dialog class="team-confirm" id="team-confirm" aria-labelledby="team-confirm-copy">
      <form method="dialog" class="team-confirm-card">
        <p id="team-confirm-copy"></p>
        <div class="hero-actions">
          <button class="btn btn-ghost" value="cancel">Cancel</button>
          <button class="btn" value="ok" id="team-confirm-go">Remove</button>
        </div>
      </form>
    </dialog>
    <script is:inline>
      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest('[data-copy]');
        if (!(button instanceof HTMLElement)) return;
        const field = document.getElementById(button.getAttribute('data-copy') || '');
        if (!field) return;
        const text = 'value' in field ? field.value : field.textContent;
        try {
          await navigator.clipboard.writeText(String(text || ''));
          button.textContent = 'Copied';
          setTimeout(() => {
            button.textContent = 'Copy';
          }, 1200);
        } catch {}
      });

      (function () {
        const dialog = document.getElementById('team-confirm');
        const copy = document.getElementById('team-confirm-copy');
        const go = document.getElementById('team-confirm-go');
        if (!(dialog instanceof HTMLDialogElement) || !copy || !go) return;
        const allowed = new WeakSet();
        let pending = null;

        document.addEventListener('submit', (event) => {
          const form = event.target;
          if (!(form instanceof HTMLFormElement)) return;
          const message = form.getAttribute('data-confirm');
          if (!message || allowed.has(form)) return;
          event.preventDefault();
          pending = form;
          copy.textContent = message;
          go.textContent = form.getAttribute('data-confirm-action') || 'Remove';
          dialog.showModal();
        });

        dialog.addEventListener('close', () => {
          const form = pending;
          pending = null;
          if (dialog.returnValue !== 'ok' || !form) return;
          allowed.add(form);
          form.requestSubmit();
        });

        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close('cancel');
        });
      })();

      (function () {
        function frameOf(input) {
          return input.closest('.image-pick-frame');
        }

        function showPreview(input, src, blob) {
          const frame = frameOf(input);
          if (!frame) return;
          const img = frame.querySelector('[data-image-preview]');
          const empty = frame.querySelector('[data-image-empty]');
          const swap = frame.querySelector('[data-image-swap]');
          if (!(img instanceof HTMLImageElement)) return;
          if (img.dataset.blob) {
            URL.revokeObjectURL(img.dataset.blob);
            delete img.dataset.blob;
          }
          if (blob) img.dataset.blob = blob;
          if (src) {
            img.src = src;
            img.hidden = false;
            if (empty) empty.hidden = true;
            if (swap) swap.hidden = false;
            return;
          }
          img.removeAttribute('src');
          img.hidden = true;
          if (empty) empty.hidden = false;
          if (swap) swap.hidden = true;
        }

        function previewFile(input) {
          const file = input.files && input.files[0];
          if (!file) {
            const current =
              frameOf(input)?.querySelector('[data-image-preview]')?.getAttribute('data-current') || '';
            showPreview(input, current);
            return;
          }
          if (!file.type.startsWith('image/')) return;
          const url = URL.createObjectURL(file);
          showPreview(input, url, url);
        }

        document.addEventListener('change', (event) => {
          const input = event.target;
          if (!(input instanceof HTMLInputElement) || !input.matches('[data-image-pick]')) return;
          previewFile(input);
        });

        document.addEventListener('input', (event) => {
          const field = event.target;
          if (!(field instanceof HTMLInputElement)) return;
          const id = field.getAttribute('data-image-url-for');
          if (!id) return;
          const input = document.getElementById(id);
          if (!(input instanceof HTMLInputElement) || (input.files && input.files[0])) return;
          const pasted = field.value.trim();
          if (!pasted) {
            const current = frameOf(input)?.querySelector('[data-image-preview]')?.getAttribute('data-current') || '';
            showPreview(input, current);
            return;
          }
          showPreview(input, pasted);
        });

        document.addEventListener('dragover', (event) => {
          const frame = event.target instanceof Element ? event.target.closest('.image-pick-frame') : null;
          if (!frame) return;
          event.preventDefault();
        });

        document.addEventListener('drop', (event) => {
          const frame = event.target instanceof Element ? event.target.closest('.image-pick-frame') : null;
          if (!frame || !event.dataTransfer) return;
          event.preventDefault();
          const input = frame.querySelector('[data-image-pick]');
          if (!(input instanceof HTMLInputElement)) return;
          const file = [...event.dataTransfer.files].find((item) => item.type.startsWith('image/'));
          if (!file) return;
          const transfer = new DataTransfer();
          transfer.items.add(file);
          input.files = transfer.files;
          previewFile(input);
        });
      })();
    </script>
  </body>
</html>
