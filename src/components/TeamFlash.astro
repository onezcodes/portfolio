---
const notices: Record<string, string> = {
  saved: 'Saved.',
  created: 'Created.',
  deleted: 'Deleted.',
  added: 'Email added to the team list.',
  invited: 'Invitation email sent.',
  'added-invited': 'Added to the team and invitation email sent.',
  'added-no-mail': 'Added to the team, but the invitation email did not send.',
  removed: 'Email removed from the team list.',
  granted: 'Access saved. New viewers were emailed.',
  'granted-no-mail': 'Access saved, but some invitation emails did not send.',
  'view-as-on': 'Preview started. You see exactly what this teammate sees. Nothing can be changed until you exit.',
  'view-as-off': 'Preview ended. You are back to your own view.',
};

const errors: Record<string, string> = {
  invalid: 'Check the form and try again.',
  forbidden: 'You cannot do that.',
  'not-found': 'That record was not found.',
  duplicate: 'That email is already on the list.',
  slug: 'That URL slug is already used.',
  'keep-admin': 'The super admin account cannot be removed.',
  'keep-lead': 'Keep at least one lead on this project.',
  'too-large': 'That image is over 5 MB.',
  'mail-setup': 'Invitation email is not set up yet. Add a Resend API key, then try Invite again.',
  'mail-failed': 'The email did not send. Try again in a moment.',
  'vault-setup': 'Credential encryption is not set up yet.',
  'view-as-readonly': 'Preview is read-only. Exit the preview to make changes.',
  'too-large-file': 'That file is over 10 MB.',
  'file-type': 'That file type cannot be attached. Use an image, PDF, text, Office file, or zip.',
  'dependency-loop': 'Those two tasks already wait on each other.',
  webhook: 'Use a Slack or Discord incoming webhook URL (https://hooks.slack.com/services/… or https://discord.com/api/webhooks/…).',
  'template-duplicate': 'A template with that name already exists.',
  meeting: 'Add at least one weekly time and a meeting link (https://…).',
  'view-as-gone': 'That teammate is no longer on the team, so the preview ended.',
  'qa-pending': 'Every assigned QA must check their checklist item before this task can be completed.',
  'no-qa': 'Add at least one QA on the People tab before creating a QA checklist.',
};

const notice = Astro.url.searchParams.get('notice');
const error = Astro.url.searchParams.get('error');
const noticeText = notice ? notices[notice] : null;
const errorText = error ? (errors[error] ?? 'Something went wrong.') : null;
---

{
  noticeText && (
    <p class="team-flash team-flash-ok" role="status">
      {noticeText}
    </p>
  )
}
{
  errorText && (
    <p class="team-flash team-flash-err" role="alert">
      {errorText}
    </p>
  )
}
