---
import {
  monthGrid,
  monthKey,
  projectEvents,
  shiftMonth,
  type CalEvent,
} from '../lib/calendar';
import type { Contribution } from '../lib/funding';
import type { LedgerEntry } from '../lib/ledger';
import type { Milestone } from '../lib/milestones';
import type { ProjectTask } from '../lib/tasks';

interface Props {
  cursor: Date;
  today: string;
  startedOn?: string | null;
  milestones?: Milestone[];
  tasks?: Pick<ProjectTask, 'title' | 'due_on' | 'status' | 'assignee_email'>[];
  contributions?: Pick<Contribution, 'amount' | 'currency' | 'occurred_on' | 'member_email' | 'notes'>[];
  entries?: Pick<LedgerEntry, 'kind' | 'amount' | 'currency' | 'occurred_on' | 'category' | 'notes'>[];
  monthHref: (month: string) => string;
  showMoney?: boolean;
  events?: CalEvent[];
  lede?: string;
}

const {
  cursor,
  today,
  startedOn = null,
  milestones = [],
  tasks = [],
  contributions = [],
  entries = [],
  monthHref,
  showMoney = true,
  events: givenEvents,
  lede,
} = Astro.props;
const events = givenEvents ?? projectEvents(startedOn, milestones, contributions, entries, showMoney, tasks);
const cells = monthGrid(cursor, events, today);
const key = monthKey(cursor);
const heading = cursor.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const monthEvents = events.filter((event) => event.date.startsWith(key));
const moneyOnCal = showMoney || events.some((event) => event.kind === 'contribution' || event.kind === 'income' || event.kind === 'expense');
const caption =
  lede ??
  (showMoney ? 'Stages, tasks, funding, and ledger dates for this project.' : 'Stages, tasks, and start date for this project.');
const weekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const prev = shiftMonth(cursor, -1);
const next = shiftMonth(cursor, 1);

function monthLink(month: string) {
  const href = monthHref(month);
  return href.includes('#') ? href : `${href}#calendar`;
}

function pretty(iso: string) {
  return new Date(`${iso}T12:00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}

function kindLabel(kind: CalEvent['kind']) {
  if (kind === 'milestone') return 'Stage';
  if (kind === 'task') return 'Task';
  if (kind === 'contribution') return 'Funding';
  if (kind === 'income') return 'Income';
  if (kind === 'expense') return 'Expense';
  return 'Start';
}
---

<section class="team-card" id="calendar">
  <div class="cal-head">
    <div class="pay-head">
      <h2>Calendar</h2>
      <p class="muted">
        {heading}. {caption}
      </p>
    </div>
    <nav class="cal-nav" aria-label="Calendar month">
      <a class="btn btn-ghost" href={monthLink(prev)}>Previous</a>
      <a class="btn btn-ghost" href={monthLink(monthKey(new Date()))}>Today</a>
      <a class="btn btn-ghost" href={monthLink(next)}>Next</a>
    </nav>
  </div>

  <ol class="cal-week" aria-hidden="true">
    {weekdays.map((day) => (
      <li>{day}</li>
    ))}
  </ol>
  <ol class="cal-grid">
    {cells.map((cell) => (
      <li class:list={['cal-day', { muted: !cell.inMonth, today: cell.today }]}>
        <span class="cal-num">{cell.day}</span>
        <ul>
          {cell.events.slice(0, 3).map((event) => (
            <li>
              {event.href ? (
                <a class={`cal-event ${event.kind}`} href={event.href} title={`${event.title} · ${event.detail}`}>
                  {event.chip ?? event.title}
                </a>
              ) : (
                <span class={`cal-event ${event.kind}`} title={`${event.title} · ${event.detail}`}>
                  {event.chip ?? event.title}
                </span>
              )}
            </li>
          ))}
          {cell.events.length > 3 && <li class="cal-more">+{cell.events.length - 3}</li>}
        </ul>
      </li>
    ))}
  </ol>

  <p class="cal-legend">
    <span><i class="cal-event milestone"></i> Stage</span>
    <span><i class="cal-event task"></i> Task</span>
    {moneyOnCal && <span><i class="cal-event contribution"></i> Funding</span>}
    {moneyOnCal && <span><i class="cal-event income"></i> Income</span>}
    {moneyOnCal && <span><i class="cal-event expense"></i> Expense</span>}
    <span><i class="cal-event start"></i> Start</span>
  </p>

  {
    monthEvents.length === 0 ? (
      <p class="muted">Nothing dated in {heading}.</p>
    ) : (
      <ol class="cal-list">
        {monthEvents.map((event) => (
          <li>
            {event.href ? (
              <a href={event.href}>
                <strong>{pretty(event.date)}</strong>
                <span>
                  {kindLabel(event.kind)} · {event.title}
                  {event.detail ? ` · ${event.detail}` : ''}
                </span>
              </a>
            ) : (
              <>
                <strong>{pretty(event.date)}</strong>
                <span>
                  {kindLabel(event.kind)} · {event.title}
                  {event.detail ? ` · ${event.detail}` : ''}
                </span>
              </>
            )}
          </li>
        ))}
      </ol>
    )
  }
</section>

<script>
  function keepCalendarInView() {
    if (location.hash !== '#calendar') return;
    const calendar = document.getElementById('calendar');
    if (!calendar) return;
    const pin = () => calendar.scrollIntoView({ block: 'start', behavior: 'instant' });
    pin();
    requestAnimationFrame(pin);
  }

  keepCalendarInView();
  if (!window.__ocCalPin) {
    window.__ocCalPin = true;
    document.addEventListener('astro:after-swap', keepCalendarInView);
    document.addEventListener('astro:page-load', keepCalendarInView);
  }
</script>
