---
import { personInitial, type PersonFace } from '../lib/profile';

interface Props {
  people: PersonFace[];
  limit?: number;
}

const { people, limit = 6 } = Astro.props;
const shown = people.slice(0, limit);
const extra = people.length - shown.length;
---

{
  people.length > 0 && (
    <ul class="face-pile" aria-label="Shared with">
      {shown.map((person) => (
        <li title={person.name}>
          {person.avatarUrl ? (
            <img class="face" src={person.avatarUrl} alt="" width="28" height="28" />
          ) : (
            <span class="face" aria-hidden="true">
              {personInitial(person.name, person.email)}
            </span>
          )}
          <span class="sr-only">{person.name}</span>
        </li>
      ))}
      {extra > 0 && (
        <li title={`${extra} more`}>
          <span class="face" aria-hidden="true">
            +{extra}
          </span>
        </li>
      )}
    </ul>
  )
}
