---
interface Props {
  projects?: { id: string; name: string }[];
  projectId?: string | null;
  action: string;
  defaultKind?: 'income' | 'expense';
}

const { projects = [], projectId = null, action, defaultKind = 'income' } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
---

<form id="new-entry" class="form team-form" method="post" action={action} enctype="multipart/form-data">
  <input type="hidden" name="intent" value="create-entry" />
  {
    projects.length > 0 && (
      <p class="field">
        <label for="project_id">Project</label>
        <select id="project_id" name="project_id">
          <option value="">Overhead (no project)</option>
          {projects.map((project) => (
            <option value={project.id} selected={project.id === projectId}>
              {project.name}
            </option>
          ))}
        </select>
      </p>
    )
  }
  {
    projectId && projects.length === 0 && <input type="hidden" name="project_id" value={projectId} />
  }
  <div class="team-form-row">
    <p class="field">
      <label for="kind">Type</label>
      <select id="kind" name="kind" required>
        <option value="income" selected={defaultKind === 'income'}>Income</option>
        <option value="expense" selected={defaultKind === 'expense'}>Expense</option>
      </select>
    </p>
    <p class="field">
      <label for="amount">Amount</label>
      <input id="amount" name="amount" type="number" min="0.01" step="0.01" required />
    </p>
    <p class="field">
      <label for="currency">Currency</label>
      <input id="currency" name="currency" value="THB" maxlength="8" required />
    </p>
    <p class="field">
      <label for="occurred_on">Date</label>
      <input id="occurred_on" name="occurred_on" type="date" value={today} required />
    </p>
  </div>
  <p class="field">
    <label for="category">Category</label>
    <input id="category" name="category" placeholder="Hosting, milestone, contractor…" />
  </p>
  <p class="field">
    <label for="notes">Notes</label>
    <textarea id="notes" name="notes" rows="3"></textarea>
  </p>
  <p class="field">
    <label for="voucher">Voucher slip</label>
    <input id="voucher" name="voucher" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
  </p>
  <p class="field">
    <label for="voucher_url">Or slip URL</label>
    <input id="voucher_url" name="voucher_url" type="url" placeholder="https://" />
  </p>
  <button class="btn" type="submit">Add entry</button>
</form>
