---
interface Props {
  id: string;
  label: string;
  value?: string;
  hasValue?: boolean;
  revealed?: boolean;
  revealField?: string;
  intent?: string;
  extras?: { name: string; value: string }[];
  multiline?: boolean;
}

const {
  id,
  label,
  value = '',
  hasValue,
  revealed = false,
  revealField,
  intent = 'reveal',
  extras = [],
  multiline = false,
} = Astro.props;
const present = hasValue ?? Boolean(value);
---

{
  present && (
    <p class="field secret-field">
      <label for={id}>{label}</label>
      {revealed ? (
        <span class="secret-row">
          {multiline ? (
            <textarea id={id} rows="3" readonly>{value}</textarea>
          ) : (
            <input id={id} type="text" readonly value={value} autocomplete="off" />
          )}
          <button class="btn btn-ghost secret-copy" type="button" data-copy={id}>
            Copy
          </button>
        </span>
      ) : revealField ? (
        <span class="secret-row">
          <span class="secret-mask" aria-hidden="true">••••••••</span>
          <form method="post">
            <input type="hidden" name="intent" value={intent} />
            <input type="hidden" name="field" value={revealField} />
            {extras.map((item) => (
              <input type="hidden" name={item.name} value={item.value} />
            ))}
            <button class="btn btn-ghost" type="submit">Reveal</button>
          </form>
        </span>
      ) : (
        <span class="secret-row">
          {multiline ? (
            <textarea id={id} rows="3" readonly>{value}</textarea>
          ) : (
            <input id={id} type="text" readonly value={value} autocomplete="off" />
          )}
          <button class="btn btn-ghost secret-copy" type="button" data-copy={id}>
            Copy
          </button>
        </span>
      )}
    </p>
  )
}
