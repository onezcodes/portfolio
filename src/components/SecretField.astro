---
interface Props {
  id: string;
  label: string;
  value?: string;
  hasValue?: boolean;
  revealed?: boolean;
  revealField?: string;
  intent?: string;
  extras?: { name: string; value: string }[];
  multiline?: boolean;
}

const {
  id,
  label,
  value = '',
  hasValue,
  revealed = false,
  revealField,
  intent = 'reveal',
  extras = [],
  multiline = false,
} = Astro.props;
const present = hasValue ?? Boolean(value);
const showValue = revealed || !revealField;
---

{
  present && (
    <div class="fact">
      <p class="fact-label">{label}</p>
      {showValue ? (
        <div class="fact-body">
          {multiline ? (
            <pre class="fact-value fact-note" id={id}>{value}</pre>
          ) : (
            <span class="fact-value" id={id}>{value}</span>
          )}
          <button class="btn-text" type="button" data-copy={id}>
            Copy
          </button>
        </div>
      ) : (
        <div class="fact-body">
          <span class="fact-mask" aria-hidden="true">••••••••</span>
          <form method="post">
            <input type="hidden" name="intent" value={intent} />
            <input type="hidden" name="field" value={revealField} />
            {extras.map((item) => (
              <input type="hidden" name={item.name} value={item.value} />
            ))}
            <button class="btn-text" type="submit">Reveal</button>
          </form>
        </div>
      )}
    </div>
  )
}
