---
interface Props {
  id: string;
  name: string;
  label: string;
  current?: string;
  size?: 'tile' | 'qr';
}

const { id, name, label, current = '', size = 'tile' } = Astro.props;
---

<p class:list={['field', 'image-pick', size]}>
  <label for={id}>{label}</label>
  <label class="image-pick-frame">
    <input
      class="sr-only"
      id={id}
      name={name}
      type="file"
      accept="image/jpeg,image/png,image/webp,image/gif"
      data-image-pick
    />
    <img
      class="image-pick-preview"
      data-image-preview
      data-current={current}
      src={current || undefined}
      alt=""
      hidden={!current}
    />
    <span class="image-pick-empty" data-image-empty hidden={Boolean(current)}>
      <strong>Choose image</strong>
      <span>JPEG, PNG, WebP or GIF</span>
    </span>
    <span class="image-pick-swap" data-image-swap hidden={!current}>Replace</span>
  </label>
</p>
