---
import { formatEventTime } from '../lib/events';
import type { ProjectCheckin } from '../lib/checkins';
import { personLabel } from '../lib/profile';
import type { TeamMember } from '../lib/ledger';

interface Props {
  latest: ProjectCheckin | null;
  recent?: ProjectCheckin[];
  people?: Pick<TeamMember, 'email' | 'display_name'>[];
  canPost?: boolean;
  canRemove?: boolean;
  actorEmail?: string;
}

const { latest, recent = [], people = [], canPost = false, canRemove = false, actorEmail = '' } = Astro.props;
const history = recent.filter((row) => row.id !== latest?.id);
---

<section class="team-card" id="checkin">
  <div class="pay-head">
    <h2>Check-in</h2>
    <p class="muted">One note for the last-known state. Not a chat.</p>
  </div>

  {
    latest ? (
      <blockquote class="checkin-latest">
        <p>{latest.body}</p>
        <footer>
          {personLabel(latest.author_email, people)} · {formatEventTime(latest.created_at)}
          {(canRemove || latest.author_email === actorEmail) && (
            <form method="post" data-confirm="Remove this check-in?">
              <input type="hidden" name="intent" value="delete-checkin" />
              <input type="hidden" name="tab" value="schedule" />
              <input type="hidden" name="checkin_id" value={latest.id} />
              <button class="ms-text" type="submit">Remove</button>
            </form>
          )}
        </footer>
      </blockquote>
    ) : (
      <p class="muted">No check-in yet. After a call or a day’s work, write what is true now.</p>
    )
  }

  {
    canPost && (
      <form class="form team-form" method="post">
        <input type="hidden" name="intent" value="add-checkin" />
        <input type="hidden" name="tab" value="schedule" />
        <p class="field">
          <label for="checkin_body">Now</label>
          <textarea id="checkin_body" name="body" rows="3" required maxlength="400" placeholder="Blocked on copy. QA on staging."></textarea>
        </p>
        <button class="btn" type="submit">Post check-in</button>
      </form>
    )
  }

  {
    history.length > 0 && (
      <details class="pay-edit">
        <summary>Earlier notes</summary>
        <ul class="team-list">
          {history.map((row) => (
            <li>
              <span>
                <strong>{row.body}</strong>
                <span>
                  {personLabel(row.author_email, people)} · {formatEventTime(row.created_at)}
                </span>
              </span>
              {(canRemove || row.author_email === actorEmail) && (
                <form method="post" data-confirm="Remove this check-in?">
                  <input type="hidden" name="intent" value="delete-checkin" />
                  <input type="hidden" name="tab" value="schedule" />
                  <input type="hidden" name="checkin_id" value={row.id} />
                  <button class="ms-text" type="submit">Remove</button>
                </form>
              )}
            </li>
          ))}
        </ul>
      </details>
    )
  }
</section>
