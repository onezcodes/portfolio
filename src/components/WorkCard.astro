---
import { Image } from 'astro:assets';
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const n = String(index + 1).padStart(2, '0');
const Tag = project.href ? 'a' : 'article';
---

<Tag
  class:list={['work-card', project.shot && 'has-shot']}
  href={project.href}
  target={project.href ? '_blank' : undefined}
  rel={project.href ? 'noopener noreferrer' : undefined}
>
  {
    project.logo ? (
      <Image
        class:list={[
          'work-logo',
          project.logoWide && 'wide',
          project.logoSquare && 'square',
          project.logoCompact && 'compact',
          project.logoLarge && 'large',
        ]}
        src={project.logo}
        alt={`${project.title} logo`}
        width={project.logoWide ? 176 : 112}
        height={project.logoWide ? 88 : 112}
        densities={[1, 2]}
      />
    ) : (
      <span class="work-index" aria-hidden="true">
        {n}
      </span>
    )
  }
  <div class="work-meta">
    <p class:list={['sector', project.comingSoon && 'soon']}>
      {project.comingSoon ? 'Coming soon' : project.sector}
    </p>
    <h3>{project.title}</h3>
    <p>{project.outcome}</p>
    {project.href && <span class="card-more">Visit site</span>}
  </div>
  <ul class="chips">
    {project.stack.map((item) => (
      <li class="chip">{item}</li>
    ))}
  </ul>
  {
    project.shot && (
      <figure class="work-preview">
        <Image
          src={project.shot}
          alt={`${project.title} on the web`}
          width={project.shot.width}
          quality={90}
          sizes="(max-width: 64rem) calc(100vw - 3rem), 22rem"
        />
      </figure>
    )
  }
</Tag>
