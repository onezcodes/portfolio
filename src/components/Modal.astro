---
/**
 * A pop-up form. Open it with any element that has data-modal-open="<id>" (links keep their
 * href as a no-JS fallback). Closes with the ✕ button, Escape, or a click on the backdrop.
 * Set `open` to show it on page load (used for ?action=… links from other pages).
 */
interface Props {
  id: string;
  title: string;
  lede?: string;
  open?: boolean;
  size?: 'md' | 'lg' | 'drawer';
}

const { id, title, lede, open = false, size = 'md' } = Astro.props;
---

<dialog
  class:list={['team-modal', size]}
  id={`modal-${id}`}
  aria-labelledby={`modal-${id}-title`}
  data-autoopen={open ? '' : undefined}
>
  <div class="team-modal-card">
    <header class="team-modal-head">
      <div>
        <h2 id={`modal-${id}-title`}>{title}</h2>
        {lede && <p class="muted">{lede}</p>}
      </div>
      <button class="team-modal-x" type="button" data-modal-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </header>
    <div class="team-modal-body">
      <slot />
    </div>
  </div>
</dialog>
