---
export const prerender = true;

import Base from '../layouts/Base.astro';
import { pages } from '../data/seo';
---

<Base title={pages.notFound.title} description={pages.notFound.description} noindex>
  <header class="page-intro wrap">
    <p class="kicker">404</p>
    <h1>This page is not here</h1>
    <p class="lede">The link may be old. Head home, see the work, or start a brief.</p>
    <p class="hero-actions">
      <a class="btn" href="/">Home</a>
      <a class="btn btn-ghost" href="/work">Work</a>
      <a class="btn btn-ghost" href="/contact">Contact</a>
    </p>
  </header>
</Base>
