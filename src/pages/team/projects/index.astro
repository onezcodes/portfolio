---
import Team from '../../../layouts/Team.astro';
import TeamFlash from '../../../components/TeamFlash.astro';
import { remainingLabel } from '../../../lib/funding';
import { projectFromForm } from '../../../lib/forms';
import { logEvent } from '../../../lib/events';
import type { LedgerEntry, Project, TeamMember } from '../../../lib/ledger';
import { seedMilestones, stagesByProject, type Milestone } from '../../../lib/milestones';
import { capsFor } from '../../../lib/access';
import { logoHrefs } from '../../../lib/projectHub';
import ProjectMark from '../../../components/ProjectMark.astro';
import FacePile from '../../../components/FacePile.astro';
import { assignedPeople, facesByProject, personInitial, personLabel } from '../../../lib/profile';

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const studio = Astro.locals.studio;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const payload = projectFromForm(form);
  if (!payload) {
    return Astro.redirect('/team/projects?new=1&error=invalid');
  }
  const { data, error } = await supabase
    .from('projects')
    .insert({
      ...payload,
      created_by: user?.id ?? null,
    })
    .select('id, name')
    .single();
  if (error || !data) {
    console.error(error?.message);
    return Astro.redirect('/team/projects?new=1&error=invalid');
  }
  await logEvent(supabase, studio?.email ?? '', {
    action: 'create',
    entityType: 'project',
    entityId: data.id,
    projectId: data.id,
    detail: data.name,
  });
  await seedMilestones(supabase, data.id, payload.started_on);
  return Astro.redirect(`/team/projects/${data.id}?notice=created`);
}

const [{ data }, { data: contribs }, { data: expenses }, { data: milestoneRows }, { data: crewRows }, { data: memberRows }] =
  await Promise.all([
    supabase.from('projects').select('id, name, client, status, logo_url, updated_at').order('updated_at', { ascending: false }),
    studio?.canLedger
      ? supabase.from('project_contributions').select('project_id, amount, currency')
      : Promise.resolve({ data: [] }),
    studio?.canLedger
      ? supabase.from('ledger_entries').select('project_id, amount, currency, kind')
      : Promise.resolve({ data: [] }),
    supabase.from('project_milestones').select('project_id, title, status, estimated_on, sort_order'),
    supabase.from('project_members').select('project_id, email'),
    supabase.from('team_members').select('email, display_name, avatar_url').order('email'),
  ]);
const projects = (data ?? []) as Project[];
const contribRows = contribs ?? [];
const expenseRows = (expenses ?? []) as Pick<LedgerEntry, 'project_id' | 'amount' | 'currency' | 'kind'>[];
const stages = stagesByProject((milestoneRows ?? []) as Milestone[]);
const people = (memberRows ?? []) as Pick<TeamMember, 'email' | 'display_name' | 'avatar_url'>[];
const assignments = (crewRows ?? []) as { project_id: string; email: string }[];
const crewFaces = facesByProject(assignments, people);
const assignees = assignedPeople(assignments, people);
const memberFilter = Astro.url.searchParams.get('member')?.trim().toLowerCase() ?? '';
const statusFilter = Astro.url.searchParams.get('status')?.trim() ?? '';
const visible = projects.filter((project) => {
  if (memberFilter && !(crewFaces.get(project.id) ?? []).some((person) => person.email === memberFilter)) return false;
  if (statusFilter && project.status !== statusFilter) return false;
  return true;
});
const creating = Astro.url.searchParams.has('new') || Astro.url.searchParams.get('error') === 'invalid';
const marks = await logoHrefs(supabase, visible);
---

<Team title="Projects">
  <div class="wrap team-page">
    <header class="team-intro">
      <p class="kicker">Projects</p>
      <h1>Internal jobs</h1>
      <p class="lede">Client, status, and notes for the team. These do not appear on /work.</p>
    </header>
    <nav class="quick-actions" aria-label="Quick actions">
      <a class="btn" href="/team/projects?new=1">New project</a>
      {studio?.canLedger && <a class="btn btn-ghost" href="/team/ledger">Studio ledger</a>}
    </nav>
    <TeamFlash />

    {
      creating && (
        <section class="team-card" id="new-project">
          <h2>New project</h2>
          <form class="form team-form" method="post">
            <p class="field">
              <label for="name">Name</label>
              <input id="name" name="name" required />
            </p>
            <div class="team-form-row">
              <p class="field">
                <label for="client">Client</label>
                <input id="client" name="client" />
              </p>
              <p class="field">
                <label for="status">Status</label>
                <select id="status" name="status">
                  <option value="active">Active</option>
                  <option value="paused">Paused</option>
                  <option value="done">Done</option>
                </select>
              </p>
              <p class="field">
                <label for="started_on">Started</label>
                <input id="started_on" name="started_on" type="date" />
              </p>
            </div>
            <p class="field">
              <label for="notes">Notes</label>
              <textarea id="notes" name="notes" rows="3"></textarea>
            </p>
            <div class="ms-tools">
              <button class="btn" type="submit">Create project</button>
              <a class="ms-text" href="/team/projects">Cancel</a>
            </div>
          </form>
        </section>
      )
    }

    <section>
      <h2 class="team-h2">{creating ? 'All projects' : 'Projects'}</h2>
      <nav class="member-filter" aria-label="Filter projects">
        {
          [
            { id: '', label: 'All' },
            { id: 'active', label: 'Active' },
            { id: 'paused', label: 'Paused' },
            { id: 'done', label: 'Done' },
          ].map((item) => (
            <a
              href={item.id ? `/team/projects?status=${item.id}${memberFilter ? `&member=${encodeURIComponent(memberFilter)}` : ''}` : `/team/projects${memberFilter ? `?member=${encodeURIComponent(memberFilter)}` : ''}`}
              aria-current={statusFilter === item.id ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      {
        assignees.length > 0 && (
          <nav class="member-filter" aria-label="Filter by assigned person">
            <a href={statusFilter ? `/team/projects?status=${statusFilter}` : '/team/projects'} aria-current={memberFilter ? undefined : 'page'}>
              Everyone
            </a>
            {assignees.map((person) => (
              <a
                href={`/team/projects?member=${encodeURIComponent(person.email)}${statusFilter ? `&status=${statusFilter}` : ''}`}
                title={person.name}
                aria-current={memberFilter === person.email ? 'page' : undefined}
              >
                {person.avatarUrl ? (
                  <img class="face" src={person.avatarUrl} alt="" width="28" height="28" />
                ) : (
                  <span class="face" aria-hidden="true">
                    {personInitial(person.name, person.email)}
                  </span>
                )}
                <span class="sr-only">{person.name}</span>
              </a>
            ))}
          </nav>
        )
      }
      {
        visible.length === 0 ? (
          <p class="muted">
            {projects.length === 0
              ? 'None yet.'
              : memberFilter
                ? `No ${statusFilter || 'matching'} projects assigned to ${personLabel(memberFilter, people)}.`
                : 'No projects match that filter.'}
          </p>
        ) : (
          <ul class="team-list">
            {visible.map((project) => (
              <li>
                <a class="project-hit" href={`/team/projects/${project.id}`}>
                  <ProjectMark name={project.name} src={marks.get(project.logo_url)} />
                  <span>
                    <strong>{project.name}</strong>
                    <span>
                      {project.client || 'No client'} · {project.status} · {stages.get(project.id) || 'No stages yet'}
                      {studio && capsFor(studio, project.id).canFinance
                        ? ` · ${remainingLabel(project.id, contribRows, expenseRows)}`
                        : ''}
                    </span>
                  </span>
                  <FacePile people={crewFaces.get(project.id) ?? []} label="Assigned" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Team>
