                <input id="ms_date" name="estimated_on" type="date" />
              </p>
            </div>
            <div class="modal-actions">
              <button class="btn btn-ghost" type="button" data-modal-close>Cancel</button>
              <button class="btn" type="submit">Add stage</button>
            </div>
          </form>
        </Modal>
      )
    }
    {
      caps.canProgress && (
        <Modal id="checkin" title="Post a check-in" lede="One note for the last-known state. It replaces the “Now” line." open={action === 'checkin'}>
          <form class="form team-form" method="post">
            <input type="hidden" name="intent" value="add-checkin" />
            <input type="hidden" name="tab" value="schedule" />
            <p class="field">
              <label for="checkin_body">Now</label>
              <textarea id="checkin_body" name="body" rows="4" required maxlength="400" placeholder="Blocked on copy. QA on staging."></textarea>
            </p>
            <div class="modal-actions">
              <button class="btn btn-ghost" type="button" data-modal-close>Cancel</button>
              <button class="btn" type="submit">Post check-in</button>
            </div>
          </form>
        </Modal>
      )
    }
    {
      caps.canFinance && (
        <Modal id="funding" title="Record funding" lede="Money a teammate put into this project. Expenses come out of it." open={action === 'contribute'}>
          <form class="form team-form" method="post" enctype="multipart/form-data">
          <input type="hidden" name="intent" value="add-contribution" />
          <input type="hidden" name="tab" value="funding" />
          <div class="team-form-row">
            <p class="field">
              <label for="member_email">Member</label>
              <select id="member_email" name="member_email" required>
                <option value="">Select</option>
                {members.map((member) => (
                  <option value={member.email}>{member.email}</option>
                ))}
              </select>
            </p>
            <p class="field">
              <label for="contrib_amount">Amount</label>
              <input id="contrib_amount" name="amount" type="number" min="0.01" step="0.01" required inputmode="decimal" />
            </p>
            <p class="field">
              <label for="contrib_currency">Currency</label>
              <input id="contrib_currency" name="currency" value="THB" maxlength="8" required />
            </p>
            <p class="field">
              <label for="contrib_date">Date</label>
              <input id="contrib_date" name="occurred_on" type="date" value={today} required />
            </p>
          </div>
          <p class="field">
            <label for="contrib_notes">Note</label>
            <input id="contrib_notes" name="notes" placeholder="Optional" />
          </p>
          <details class="modal-extra">
            <summary>Voucher slip</summary>
            <ImagePick id="contrib_voucher" name="voucher" label="Voucher slip" />
          <p class="field">
            <label for="contrib_voucher_url">Or slip URL</label>
            <input
              id="contrib_voucher_url"
              name="voucher_url"
              type="url"
              placeholder="https://"
              data-image-url-for="contrib_voucher"
            />
          </p>
          </details>
          <button class="btn" type="submit">Record funding</button>
        </form>
        </Modal>
      )
    }
    {
      caps.canFinance && (
        <Modal id="entry" title="Add income or expense" lede="Expenses come out of team funding." open={action === 'expense'}>
          <LedgerForm action={`/team/projects/${row.id}`} projectId={row.id} defaultKind="expense" idPrefix="entry_" submitLabel="Save entry" compact />
        </Modal>
      )
    }
    {
      caps.canPeople && (
        <Modal id="person" title="Add a person" lede="Pick someone from the studio list and choose what they can do here." open={action === 'invite'}>
          {
            invitees.length === 0 ? (
              <p class="muted">Everyone on the whitelist is already on this project.</p>
            ) : (
              <form class="form team-form" method="post">
                        <input type="hidden" name="intent" value="add-member" />
                        <input type="hidden" name="tab" value="people" />
                        <p class="field">
                          <label for="people_email">Email</label>
                          <select id="people_email" name="email" required>
                            <option value="">Select</option>
                            {invitees.map((member) => (
                              <option value={member.email}>
                                {personLabel(member.email, members) === member.email
                                  ? member.email
                                  : `${personLabel(member.email, members)} · ${member.email}`}
                              </option>
                            ))}
                          </select>
                        </p>
                        <fieldset class="role-picks">
                          <legend class="muted">Roles</legend>
                          {ROLE_META.map((role) => (
                            <label>
                              <input type="checkbox" name="roles" value={role.id} />
                              <span>
                                {role.label}
                                <span>{role.hint}</span>
                              </span>
                            </label>
                          ))}
                        </fieldset>
                        <label class="check-line">
                          <input type="checkbox" name="send_invite" value="1" checked />
                          Email them about this project
                        </label>
                        <button class="btn" type="submit">Add to project</button>
                      </form>
            )
          }
        </Modal>
      )
    }

    {
      caps.canProgress && (
        <Modal id="bug" title="Report a bug" lede="It becomes a task tagged Bug. Leads and managers are notified." open={action === 'bug'} size="lg">
          <form class="form team-form" method="post" enctype="multipart/form-data">
            <input type="hidden" name="intent" value="report-bug" />
            <input type="hidden" name="tab" value="tasks" />
            <p class="field">
              <label for="bug_title">What's wrong?</label>
              <input id="bug_title" name="title" required maxlength="200" placeholder="Checkout button does nothing on iOS" />
            </p>
            <div class="team-form-row">
              <p class="field">
                <label for="bug_severity">Severity</label>
                <select id="bug_severity" name="severity">
                  <option value="critical">Critical · broken, no workaround</option>
                  <option value="major">Major · important, has a workaround</option>
                  <option value="minor" selected>Minor · cosmetic or small</option>
                </select>
              </p>
              <p class="field">
                <label for="bug_stage">Stage</label>
                <select id="bug_stage" name="milestone_id">
                  <option value="">No stage</option>
                  {milestones.map((item) => (
                    <option value={item.id} selected={item.id === stage?.id}>{item.title}</option>
                  ))}
                </select>
              </p>
              <p class="field">
                <label for="bug_owner">Assign to</label>
                <select id="bug_owner" name="assignee_email">
                  <option value="">Triage later</option>
                  {taskPeople.map((person) => (
                    <option value={person.email}>{personLabel(person.email, taskPeople)}{awayTag(person.email)}</option>
                  ))}
                </select>
              </p>
            </div>
            <p class="field">
              <label for="bug_steps">Steps to reproduce</label>
              <textarea id="bug_steps" name="steps" rows="3" placeholder="1. Open the app&#10;2. Add an item&#10;3. Tap Checkout"></textarea>
            </p>
            <div class="team-form-row">
              <p class="field">
                <label for="bug_expected">Expected</label>
                <input id="bug_expected" name="expected" placeholder="Payment sheet opens" />
              </p>
              <p class="field">
                <label for="bug_actual">Actual</label>
                <input id="bug_actual" name="actual" placeholder="Nothing happens" />
              </p>
            </div>
            <p class="field">
              <label for="bug_device">Device / browser</label>
              <input id="bug_device" name="device" placeholder="iPhone 15, iOS 18.2 · build 1.4.0" />
            </p>
            <p class="field">
              <label for="bug_file">Screenshot or recording (optional, 10 MB)</label>
              <input id="bug_file" name="file" type="file" accept="image/*,application/pdf,text/plain" />
            </p>
            <div class="modal-actions">
              <button class="btn btn-ghost" type="button" data-modal-close>Cancel</button>
              <button class="btn" type="submit">Report bug</button>
            </div>
          </form>
        </Modal>
      )
    }
    {
      caps.canProgress && (
        <Modal id="signoff" title="Sign off stage" lede="Close the stage and note what was delivered. It shows on the schedule and in team chat.">
          <form class="form team-form" method="post">
            <input type="hidden" name="intent" value="milestone-done" />
            <input type="hidden" name="tab" value="schedule" />
            <input type="hidden" name="milestone_id" value="" data-signoff-id />
            <p class="signoff-stage" data-signoff-title></p>
            <p class="field">
              <label for="signoff_note">What was delivered? (optional)</label>
              <textarea id="signoff_note" name="signoff_note" rows="3" maxlength="600" placeholder="Designs approved by the client in Figma. Build handed to QA."></textarea>
            </p>
            <div class="modal-actions">
              <button class="btn btn-ghost" type="button" data-modal-close>Cancel</button>
              <button class="btn" type="submit">Mark done</button>
            </div>
          </form>
        </Modal>
      )
    }
    {
      caps.canPlan && (
        <Modal id="skipstage" title="Skip stage" lede="Close a stage that no longer applies. It stays on the schedule as skipped and leaves the progress count.">
          <form class="form team-form" method="post">
            <input type="hidden" name="intent" value="milestone-skip" />
            <input type="hidden" name="tab" value="schedule" />
            <input type="hidden" name="milestone_id" value="" data-skip-id />
            <p class="signoff-stage" data-skip-title></p>
            <p class="field">
              <label for="skip_note">Why skip it? (optional)</label>
              <textarea id="skip_note" name="skip_note" rows="3" maxlength="600" placeholder="Client dropped the Play Store release for now."></textarea>
            </p>
            <div class="modal-actions">
              <button class="btn btn-ghost" type="button" data-modal-close>Cancel</button>
              <button class="btn" type="submit">Skip stage</button>
            </div>
          </form>
        </Modal>
      )
    }
    {
      caps.canPlan && (
        <Modal id="template" title="Save as template" lede="Reuse this project's stages and tasks for the next job. Dates are kept relative to the start date." open={action === 'template'}>
          <form class="form team-form" method="post">
            <input type="hidden" name="intent" value="save-template" />
            <input type="hidden" name="tab" value="schedule" />
            <p class="field">
              <label for="template_name">Template name</label>
              <input id="template_name" name="template_name" required maxlength="80" value={`${row.name} plan`} />
            </p>
            <p class="muted">{milestones.length} stages and {tasks.filter((item) => 'kind' in item ? item.kind !== 'bug' : true).length} tasks will be saved.</p>
            <div class="modal-actions">
              <button class="btn btn-ghost" type="button" data-modal-close>Cancel</button>
              <button class="btn" type="submit">Save template</button>
            </div>
          </form>
        </Modal>
      )
    }
    {!Astro.locals.viewAs && <PersonalPanel items={mine} tab={tab} open={action === 'mine'} />}
  </div>
  {
    !Astro.locals.viewAs && (
      <button class="mine-fab" type="button" data-modal-open="mine" aria-label="My private notes and to-dos" aria-keyshortcuts="M" title="My notes, private (M)">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 4h10l4 4v12H5z M14 4v5h5 M8 13h8 M8 17h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" /></svg>
        <span class="pd-mine-badge" data-mine-badge>{mineOpen || ''}</span>
      </button>
    )
  }
</Team>

<script>
  // Meeting form: add or remove weekly time rows (keep at least one).
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const add = target?.closest('[data-slot-add]');
    const remove = target?.closest('[data-slot-remove]');
    if (add) {
      const box = add.closest('[data-slots]');
      const rows = box?.querySelectorAll('[data-slot]');
      const last = rows?.[rows.length - 1];
      if (!box || !last || (rows?.length ?? 0) >= 14) return;
      const copy = last.cloneNode(true) as HTMLElement;
      box.insertBefore(copy, add);
    } else if (remove) {
      const box = remove.closest('[data-slots]');
      if ((box?.querySelectorAll('[data-slot]').length ?? 0) > 1) remove.closest('[data-slot]')?.remove();
    }
  });

  // "Mark done" on a stage opens the sign-off pop-up for that stage.
  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>('[data-signoff-for]');
    if (!button) return;
    const dialog = document.getElementById('modal-signoff');
    dialog?.querySelector<HTMLInputElement>('[data-signoff-id]')?.setAttribute('value', button.dataset.signoffFor ?? '');
    const title = dialog?.querySelector<HTMLElement>('[data-signoff-title]');
    if (title) title.textContent = button.dataset.signoffTitle ?? '';
  }, true);

  // "Skip" on a stage opens the skip pop-up for that stage.
  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>('[data-skip-for]');
    if (!button) return;
    const dialog = document.getElementById('modal-skipstage');
    dialog?.querySelector<HTMLInputElement>('[data-skip-id]')?.setAttribute('value', button.dataset.skipFor ?? '');
    const title = dialog?.querySelector<HTMLElement>('[data-skip-title]');
    if (title) title.textContent = button.dataset.skipTitle ?? '';
  }, true);

  // Close the "More" menu on outside click or Escape.
  document.addEventListener('click', (event) => {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.pd-more[open]')) {
      if (!(event.target instanceof Node) || !menu.contains(event.target)) menu.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.pd-more[open]')) menu.open = false;
  });
</script>
