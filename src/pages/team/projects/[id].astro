import TeamFlash from '../../../components/TeamFlash.astro';
import LedgerForm from '../../../components/LedgerForm.astro';
import VoucherLink from '../../../components/VoucherLink.astro';
import BankPayCard from '../../../components/BankPayCard.astro';
import IncomeExpenseChart from '../../../components/IncomeExpenseChart.astro';
import FundingPie from '../../../components/FundingPie.astro';
import MilestoneTrack from '../../../components/MilestoneTrack.astro';
import CheckIn from '../../../components/CheckIn.astro';
import ProjectCalendar from '../../../components/ProjectCalendar.astro';
import { parseMonth } from '../../../lib/calendar';
import { projectFromForm } from '../../../lib/forms';
import { money, todayIso, totalsByCurrency, type LedgerEntry, type Project, type TeamMember } from '../../../lib/ledger';
import {
  addContribution,
  contributionsByMember,
  fundTransactions,
  fundingByCurrency,
  removeContribution,
  updateProjectBank,
  type Contribution,
} from '../../../lib/funding';
import { createLedgerEntry, removeLedgerEntry, voucherHrefs } from '../../../lib/vouchers';
import {
  addMilestone,
  removeMilestone,
  seedMilestones,
  setMilestoneStatus,
  currentStage,
  stageCounts,
  stageLabel,
  updateMilestone,
  sortMilestones,
  type Milestone,
} from '../../../lib/milestones';
import {
  addComment,
  addSubtask,
  addQaChecklist,
  addTask,
  isTaskStatus,
  markTaskMail,
  removeComment,
  removeSubtask,
  removeTask,
  setTaskStatus,
  shouldNotifyAssignee,
  sortTaskQueue,
  taskCounts,
  taskDetail,
  taskIsLate,
  toggleSubtask,
  updateTask,
  type ProjectTask,
} from '../../../lib/tasks';
import { addCheckin, removeCheckin, type ProjectCheckin } from '../../../lib/checkins';
import { sendProjectInvite, sendTaskAssigned, sendTaskComment, taskWorkUrl } from '../../../lib/mail';
import { logEvent } from '../../../lib/events';
import { personFace, personInitial, personLabel } from '../../../lib/profile';
import SecretField from '../../../components/SecretField.astro';
import ProjectMark from '../../../components/ProjectMark.astro';
import FacePile from '../../../components/FacePile.astro';
import Modal from '../../../components/Modal.astro';
import PersonalPanel from '../../../components/PersonalPanel.astro';
import { clearDonePersonal, handlePersonal, personalItems } from '../../../lib/personal';
import TaskWorkspace from '../../../components/TaskWorkspace.astro';
import TaskPanel from '../../../components/TaskPanel.astro';
import {
  addDependency,
  addFileAttachment,
  addLinkAttachment,
  attachmentHrefs,
  deleteView,
  follow,
  followersOf,
  logTaskEvent,
  notify,
  parseMentions,
  projectDependencies,
  removeAttachment,
  removeDependency,
  saveView,
  savedViews,
  unfollow,
  viewQuery,
} from '../../../lib/taskCollab';
import { formatMinutes, logTime, removeTime, startTimer, stopTimer, taskTime } from '../../../lib/timeTracking';
import { maskWebhook, parseWebhookUrl, postToChat, webhookKind } from '../../../lib/chat';
import { applyChecklist, applyQaChecklist, listTemplates, saveProjectAsTemplate } from '../../../lib/templates';
import {
  addQaItems,
  createQaChecklist,
  createQaChecklistFromTemplate,
  listQaChecklists,
  removeQaCheck,
  removeQaChecklist,
  toggleQaCheck,
} from '../../../lib/qaChecklists';
import QaChecklistWorkspace from '../../../components/QaChecklistWorkspace.astro';
import { projectHealth } from '../../../lib/health';
import { availabilityOf, TIME_ZONES } from '../../../lib/presence';
import {
  addDays,
  DAY_NAMES,
  DEFAULT_RUN_DAYS,
  daysLeft,
  zonedDate,
  meetingFromForm,
  meetingHref,
  nextOccurrence,
  projectMeetings,
  relativeLabel,
  sameClock,
  scheduleLabel,
  whenLabel,
  zoneName,
  type ProjectMeeting,
} from '../../../lib/meetings';
import { siteUrl } from '../../../lib/supabase';
import ImagePick from '../../../components/ImagePick.astro';
import { decryptSecret, vaultReady, websiteHref } from '../../../lib/credentials';
import {
  extraLinksOf,
  hubFromForm,
  loginPasswordFromForm,
  logoFromForm,
  PROJECT_URL_FIELDS,
  projectLinks,
} from '../../../lib/projectHub';
import { isHttpUrl } from '../../../lib/vouchers';
import {
  allowedIntent,
  capsFor,
  parseRoles,
  pickTab,
  ROLE_META,
  roleLabels,
  rolesFromForm,
  tabForIntent,
  wouldDropLastLead,
  type ProjectMemberRow,
  type ProjectTab,
} from '../../../lib/access';

function projectHref(
  projectId: string,
  opts: {
    tab?: ProjectTab;
    month?: string | null;
    notice?: string;
    error?: string;
    action?: string;
    task?: string;
    view?: string;
    who?: string;
  } = {},
) {
  const params = new URLSearchParams();
  params.set('tab', opts.tab ?? 'schedule');
  if (opts.month) params.set('month', opts.month);
  if (opts.view) params.set('view', opts.view);
  if (opts.who) params.set('who', opts.who);
  if (opts.task) params.set('task', opts.task);
  if (opts.action) params.set('action', opts.action);
  if (opts.notice) params.set('notice', opts.notice);
  if (opts.error) params.set('error', opts.error);
  return `/team/projects/${projectId}?${params}`;
}

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
// Super admin can preview the app as a teammate (read-only). Hidden while already previewing.
const canViewAs = Boolean(Astro.locals.realStudio?.owner && !Astro.locals.viewAs);
const studio = Astro.locals.studio;
const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/team/projects');
}
if (!studio) {
  return Astro.redirect('/team/login');
}

const caps = capsFor(studio, id);
if (!caps.assigned) {
  return Astro.redirect('/team/projects?error=forbidden');
}

const fundViewer = { email: studio.email, superAdmin: studio.superAdmin };

let revealedLogin = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'update');
  const requestedTab = String(form.get('tab') ?? '');
  const tab = caps.tabs.some((item) => item.id === requestedTab)
    ? (requestedTab as ProjectTab)
    : pickTab(tabForIntent(intent), caps);
  // Task forms send back the open task, view, and filter so the page returns to the same place.
  const keep = {
    task: String(form.get('return_task') ?? '') || undefined,
    view: String(form.get('view') ?? '') || undefined,
    who: String(form.get('who') ?? '') || undefined,
  };
  const bounce = (flash: { notice?: string; error?: string }) =>
    Astro.redirect(projectHref(id, { tab, ...keep, ...flash }));
  const actor = studio.email;
  const track = (action: string, detail = '', entityType = 'project') =>
    logEvent(supabase, actor, { action, entityType, entityId: id, projectId: id, detail });
  // Team chat (Slack/Discord) for this project, if configured.
  const chat = async (text: string, path = `/team/projects/${id}`) => {
    const { data: hook } = await supabase.from('projects').select('name, chat_webhook_url').eq('id', id).maybeSingle();
    if (hook?.chat_webhook_url) {
      await postToChat(String(hook.chat_webhook_url), `[${hook.name}] ${text}`, `${siteUrl(Astro.request)}${path}`);
    }
  };
  const who = studio.displayName || actor;

  if (!allowedIntent(intent, caps)) {
    return bounce({ error: 'forbidden' });
  }

  if (intent.startsWith('mine-')) {
    const ok = intent === 'mine-clear' ? await clearDonePersonal(supabase, id) : await handlePersonal(supabase, intent, form, id);
    return Astro.redirect(projectHref(id, { tab, action: 'mine', ...(ok ? {} : { error: 'invalid' }) }));
  }

  if (intent === 'reveal') {
    if (String(form.get('field') ?? '') !== 'password') return bounce({ error: 'invalid' });
    revealedLogin = true;
    await track('reveal', 'login password');
  } else if (intent === 'delete') {
    const { data: current } = await supabase.from('projects').select('logo_url, qr_url').eq('id', id).maybeSingle();
    const { data: taskFiles } = await supabase.from('project_tasks').select('image_url').eq('project_id', id);
    const { error } = await supabase.from('projects').delete().eq('id', id);
    if (error) return bounce({ error: 'invalid' });
    const stored = [
      current?.logo_url,
      current?.qr_url,
      ...(taskFiles ?? []).map((item) => item.image_url),
    ].filter((path): path is string => Boolean(path) && !isHttpUrl(path));
    if (stored.length > 0) await supabase.storage.from('vouchers').remove(stored);
    await track('delete');
    return Astro.redirect('/team/projects?notice=deleted');
  }

  if (intent === 'create-entry') {
    const result = await createLedgerEntry(supabase, form, user?.id ?? null, id);
    if (result.error) return bounce({ error: result.error });
    await track('create', '', 'ledger');
    return bounce({ notice: 'created' });
  }

  if (intent === 'delete-entry') {
    const entryId = String(form.get('entry_id') ?? '');
    if (!entryId) return bounce({ error: 'invalid' });
    const result = await removeLedgerEntry(supabase, entryId, id);
    if (result.error) return bounce({ error: 'invalid' });
    await track('delete', '', 'ledger');
    return bounce({ notice: 'deleted' });
  }

  if (intent === 'update-funding') {
    if (!user?.id) return bounce({ error: 'invalid' });
    const { data: current } = await supabase.from('projects').select('qr_url').eq('id', id).maybeSingle();
    const result = await updateProjectBank(supabase, form, id, user.id, current?.qr_url ?? '');
    if (result.error) return bounce({ error: result.error });
    await track('update', 'pay details');
    return bounce({ notice: 'saved' });
  }

  if (intent === 'add-contribution') {
    const result = await addContribution(supabase, form, id, user?.id ?? null);
    if (result.error) return bounce({ error: result.error });
    await track('create', '', 'contribution');
    return bounce({ notice: 'created' });
  }

  if (intent === 'delete-contribution') {
    const contribId = String(form.get('contribution_id') ?? '');
    if (!contribId) return bounce({ error: 'invalid' });
    const result = await removeContribution(supabase, contribId, id, fundViewer);
    if (result.error) return bounce({ error: result.error });
    await track('delete', '', 'contribution');
    return bounce({ notice: 'deleted' });
  }

  if (intent === 'add-milestone') {
    const result = await addMilestone(supabase, form, id);
    if (result.error) return bounce({ error: result.error });
    await track('create', '', 'milestone');
    return bounce({ notice: 'created' });
  }

  if (intent === 'seed-milestones') {
    const { data: current } = await supabase.from('projects').select('started_on').eq('id', id).maybeSingle();
    const result = await seedMilestones(supabase, id, current?.started_on ?? null);
    if (result.error) return bounce({ error: result.error });
    await track('create', 'seeded', 'milestone');
    return bounce({ notice: 'created' });
  }

  if (intent === 'update-milestone') {
    const result = await updateMilestone(supabase, form, id);
    if (result.error) return bounce({ error: 'invalid' });
    await track('update', '', 'milestone');
    return bounce({ notice: 'saved' });
  }

  if (intent === 'milestone-skip') {
    // Skip a stage that no longer applies; the note (optional) says why.
    const milestoneId = String(form.get('milestone_id') ?? '');
    if (!milestoneId) return bounce({ error: 'invalid' });
    const result = await setMilestoneStatus(supabase, id, milestoneId, 'skipped');
    if (result.error) return bounce({ error: 'invalid' });
    const note = String(form.get('skip_note') ?? '').trim().slice(0, 600);
    const { data: skipped } = await supabase
      .from('project_milestones')
      .update({ signoff_note: note, signed_off_by: actor, signed_off_at: new Date().toISOString() })
      .eq('id', milestoneId)
      .eq('project_id', id)
      .select('title')
      .maybeSingle();
    await chat(`⏭️ ${who} skipped stage “${skipped?.title ?? 'stage'}”${note ? `: ${note}` : ''}`, `/team/projects/${id}?tab=schedule`);
    await track('status', 'skipped', 'milestone');
    return bounce({ notice: 'saved' });
  }

  if (intent === 'milestone-current' || intent === 'milestone-done' || intent === 'milestone-reopen') {
    const milestoneId = String(form.get('milestone_id') ?? '');
    if (!milestoneId) return bounce({ error: 'invalid' });
    const status = intent === 'milestone-current' ? 'current' : intent === 'milestone-done' ? 'done' : 'pending';
    const result = await setMilestoneStatus(supabase, id, milestoneId, status);
    if (!result.error && status === 'done') {
      // Sign-off: who closed the stage, when, and what was delivered.
      const note = String(form.get('signoff_note') ?? '').trim().slice(0, 600);
      const { data: closed } = await supabase
        .from('project_milestones')
        .update({ signoff_note: note, signed_off_by: actor, signed_off_at: new Date().toISOString() })
        .eq('id', milestoneId)
        .eq('project_id', id)
        .select('title')
        .maybeSingle();
      await chat(`✅ ${who} signed off stage “${closed?.title ?? 'stage'}”${note ? `: ${note}` : ''}`, `/team/projects/${id}?tab=schedule`);
    }
    if (!result.error && status === 'pending') {
      await supabase
        .from('project_milestones')
        .update({ signoff_note: '', signed_off_by: '', signed_off_at: null })
        .eq('id', milestoneId)
        .eq('project_id', id);
    }
    if (result.error) return bounce({ error: 'invalid' });
    await track('status', status, 'milestone');
    return bounce({ notice: 'saved' });
  }

  if (intent === 'delete-milestone') {
    const milestoneId = String(form.get('milestone_id') ?? '');
    if (!milestoneId) return bounce({ error: 'invalid' });
    const result = await removeMilestone(supabase, milestoneId, id);
    if (result.error) return bounce({ error: 'invalid' });
    await track('delete', '', 'milestone');
    return bounce({ notice: 'deleted' });
  }

  if (intent === 'add-task') {
    const result = await addTask(supabase, form, id, user?.id ?? null, actor);
    if (result.error) return bounce({ error: result.error });
    await track('create', result.title, 'task');
    await follow(supabase, result.id, actor);
    if (result.assignee_email) {
      await follow(supabase, result.id, result.assignee_email);
      await notify(supabase, actor, [result.assignee_email], { kind: 'assigned', projectId: id, taskId: result.id, title: result.title });
    }
    await chat(
      `➕ ${who} added “${result.title}”${result.assignee_email ? ` for ${result.assignee_email}` : ''}`,
      `/team/projects/${id}?tab=tasks&task=${result.id}`,
    );
    if (shouldNotifyAssignee(result.assignee_email, actor)) {
      const { data: named } = await supabase.from('projects').select('name').eq('id', id).maybeSingle();
      const mail = await sendTaskAssigned(
        result.assignee_email,
        named?.name ?? 'a project',
        result.title,
        result.due_on,
        taskWorkUrl(Astro.request, id, result.id),
      );
      if (!mail.error) await markTaskMail(supabase, result.id);
    }
    return bounce({ notice: 'created' });
  }

  if (intent === 'update-task') {
    const result = await updateTask(supabase, form, id, user?.id ?? null);
    if (result.error) return bounce({ error: result.error });
    await track('update', result.title, 'task');
    if (result.assignee_email && result.assignee_email !== result.previous_assignee) {
      await follow(supabase, result.id, result.assignee_email);
      await notify(supabase, actor, [result.assignee_email], { kind: 'assigned', projectId: id, taskId: result.id, title: result.title });
    }
    if (shouldNotifyAssignee(result.assignee_email, actor, result.previous_assignee)) {
      const { data: named } = await supabase.from('projects').select('name').eq('id', id).maybeSingle();
      const mail = await sendTaskAssigned(
        result.assignee_email,
        named?.name ?? 'a project',
        result.title,
        result.due_on,
        taskWorkUrl(Astro.request, id, result.id),
      );
      if (!mail.error) await markTaskMail(supabase, result.id);
    }
    return bounce({ notice: 'saved' });
  }

  if (intent === 'task-todo' || intent === 'task-doing' || intent === 'task-blocked' || intent === 'task-done') {
    const taskId = String(form.get('task_id') ?? '');
    const status = intent.slice('task-'.length);
    if (!taskId || !isTaskStatus(status)) return bounce({ error: 'invalid' });
    const result = await setTaskStatus(supabase, id, taskId, status);
    if (result.error) return bounce({ error: result.error });
    await track('status', status, 'task');
    if (status === 'done') {
      const [{ data: done }, watchers] = await Promise.all([
        supabase.from('project_tasks').select('title, created_by_email').eq('id', taskId).maybeSingle(),
        followersOf(supabase, taskId),
      ]);
      if (done) {
        await notify(supabase, actor, [...watchers, String(done.created_by_email ?? '')], {
          kind: 'completed',
          projectId: id,
          taskId,
          title: String(done.title),
        });
        await chat(`🎉 ${who} completed “${done.title}”`, `/team/projects/${id}?tab=tasks&task=${taskId}`);
      }
    }
    return bounce({ notice: 'saved' });
  }

  if (intent === 'add-subtask') {
    const result = await addSubtask(supabase, form);
    if (result.error) return bounce({ error: result.error });
    await logTaskEvent(supabase, String(form.get('task_id') ?? ''), actor, 'subtask_add', result.title);
    return bounce({});
  }

  if (intent === 'add-qa-checklist') {
    const taskId = String(form.get('task_id') ?? '');
    const result = await addQaChecklist(supabase, form, id);
    if (result.error) return bounce({ error: result.error });
    const label = (result.titles ?? []).join(', ') || 'QA checklist';
    await logTaskEvent(supabase, taskId, actor, 'subtask_add', `${result.count} QA checks · ${label}`);
    const { data: target } = await supabase.from('project_tasks').select('title').eq('id', taskId).maybeSingle();
    await notify(supabase, actor, result.assignees, {
      kind: 'assigned',
      projectId: id,
      taskId,
      title: String(target?.title ?? 'a task'),
      body: 'QA checklist assigned — check your items before this task can be completed.',
    });
    for (const email of result.assignees) await follow(supabase, taskId, email);
    return bounce({ notice: 'saved' });
  }

  if (intent === 'toggle-subtask') {
    const result = await toggleSubtask(supabase, form, id, actor, caps.canPlan);
    if (result.error) return bounce({ error: result.error });
    if (result.done && result.taskId) await logTaskEvent(supabase, result.taskId, actor, 'subtask_done', result.title);
    return bounce({});
  }

  if (intent === 'delete-subtask') {
    const result = await removeSubtask(supabase, form, id, caps.canPlan);
    return result.error ? bounce({ error: result.error }) : bounce({});
  }

  if (intent === 'add-comment') {
    const { data: crewEmails } = await supabase.from('project_members').select('email').eq('project_id', id);
    const mentioned = parseMentions(String(form.get('body') ?? ''), (crewEmails ?? []) as { email: string }[]).filter(
      (email) => email !== actor,
    );
    const result = await addComment(supabase, form, actor, mentioned);
    if (result.error) return bounce({ error: result.error });
    const taskId = String(form.get('task_id') ?? '');
    const watchers = await followersOf(supabase, taskId);
    await follow(supabase, taskId, actor);
    const { data: target } = await supabase
      .from('project_tasks')
      .select('title, assignee_email, projects(name)')
      .eq('id', taskId)
      .eq('project_id', id)
      .maybeSingle();
    await track('comment', String(target?.title ?? '').slice(0, 80), 'task');
    const commentTitle = String(target?.title ?? 'a task');
    const snippet = (result.body ?? '').slice(0, 280);
    // Mentioned people: inbox + email. Assignee and followers: inbox.
    await notify(supabase, actor, mentioned, { kind: 'mention', projectId: id, taskId, title: commentTitle, body: snippet });
    await notify(
      supabase,
      actor,
      [...watchers, String(target?.assignee_email ?? '')].filter((email) => !mentioned.includes(email)),
      { kind: 'comment', projectId: id, taskId, title: commentTitle, body: snippet },
    );
    const mentionProject = (target?.projects as { name?: string } | null)?.name ?? 'a project';
    for (const email of mentioned) {
      await follow(supabase, taskId, email);
      await sendTaskComment(email, mentionProject, commentTitle, studio.displayName || actor, result.body ?? '', taskWorkUrl(Astro.request, id, taskId), true);
    }
    // Tell the assignee by email too, unless they wrote it or were already mentioned.
    const assignee = String(target?.assignee_email ?? '').trim().toLowerCase();
    if (target && assignee && assignee !== actor && !mentioned.includes(assignee)) {
      const projectName = (target.projects as { name?: string } | null)?.name ?? 'a project';
      await sendTaskComment(
        assignee,
        projectName,
        String(target.title),
        studio.displayName || actor,
        result.body ?? '',
        taskWorkUrl(Astro.request, id, taskId),
      );
    }
    return bounce({});
  }

  if (intent === 'delete-comment') {
    const result = await removeComment(supabase, form, id);
    return result.error ? bounce({ error: result.error }) : bounce({});
  }

  if (intent === 'follow' || intent === 'unfollow') {
    const taskId = String(form.get('task_id') ?? '');
    const who = String(form.get('email') ?? '').trim().toLowerCase() || actor;
    if (!taskId || (who !== actor && !caps.canPlan)) return bounce({ error: 'forbidden' });
    if (intent === 'follow') {
      await follow(supabase, taskId, who);
      if (who !== actor) {
        await logTaskEvent(supabase, taskId, actor, 'follow', who);
        const { data: named } = await supabase.from('project_tasks').select('title').eq('id', taskId).maybeSingle();
        await notify(supabase, actor, [who], { kind: 'follow', projectId: id, taskId, title: String(named?.title ?? 'a task') });
      }
    } else {
      const result = await unfollow(supabase, taskId, who);
      if (result.error) return bounce({ error: 'forbidden' });
    }
    return bounce({});
  }

  if (intent === 'add-attachment') {
    const result = await addFileAttachment(supabase, form, id, actor);
    if (result.error) return bounce({ error: result.error });
    await logTaskEvent(supabase, String(form.get('task_id') ?? ''), actor, 'attach', result.name);
    return bounce({});
  }

  if (intent === 'add-link') {
    const result = await addLinkAttachment(supabase, form, actor);
    if (result.error) return bounce({ error: result.error });
    await logTaskEvent(supabase, String(form.get('task_id') ?? ''), actor, 'attach', result.name);
    return bounce({});
  }

  if (intent === 'delete-attachment') {
    const result = await removeAttachment(supabase, form, id);
    return result.error ? bounce({ error: result.error }) : bounce({});
  }

  if (intent === 'add-dependency' || intent === 'delete-dependency') {
    const result = intent === 'add-dependency' ? await addDependency(supabase, form) : await removeDependency(supabase, form, id);
    if (result.error) return bounce({ error: result.error });
    const { data: other } = await supabase
      .from('project_tasks')
      .select('title')
      .eq('id', String(form.get('depends_on_id') ?? ''))
      .maybeSingle();
    await logTaskEvent(
      supabase,
      String(form.get('task_id') ?? ''),
      actor,
      intent === 'add-dependency' ? 'depend_add' : 'depend_remove',
      String(other?.title ?? ''),
    );
    return bounce({});
  }

  if (intent === 'save-view') {
    const result = await saveView(supabase, form, id, actor);
    if (result.error) return bounce({ error: result.error });
    const query = String(form.get('view_query') ?? '');
    return Astro.redirect(`${projectHref(id, { tab: 'tasks' })}${query ? `&${query}` : ''}&notice=saved`);
  }

  if (intent === 'delete-view') {
    const result = await deleteView(supabase, form);
    return result.error ? bounce({ error: result.error }) : bounce({ notice: 'deleted' });
  }

  if (intent === 'add-meeting' || intent === 'update-meeting') {
    const payload = meetingFromForm(form);
    if (!payload) return bounce({ error: 'meeting' });
    const meetingId = String(form.get('meeting_id') ?? '');
    const { error: meetingError } =
      intent === 'add-meeting'
        ? await supabase.from('project_meetings').insert({ ...payload, project_id: id, created_by: actor })
        : await supabase.from('project_meetings').update(payload).eq('id', meetingId).eq('project_id', id);
    if (meetingError) {
      console.error('meeting save failed', meetingError.message);
      return bounce({ error: 'invalid' });
    }
    await track(intent === 'add-meeting' ? 'create' : 'update', `meeting: ${payload.title}`);
    if (intent === 'add-meeting') await chat(`📅 ${who} set up “${payload.title}”: ${payload.slots.length} ${payload.slots.length === 1 ? 'session' : 'sessions'} a week`);
    return bounce({ notice: 'saved' });
  }

  if (intent === 'skip-meeting' || intent === 'unskip-meeting') {
    const meetingId = String(form.get('meeting_id') ?? '');
    const date = String(form.get('date') ?? '');
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return bounce({ error: 'invalid' });
    const { data: current } = await supabase.from('project_meetings').select('skip_dates, title').eq('id', meetingId).eq('project_id', id).maybeSingle();
    if (!current) return bounce({ error: 'not-found' });
    const today = new Date().toISOString().slice(0, 10);
    const dates = new Set(((current.skip_dates ?? []) as string[]).filter((d) => d >= today));
    if (intent === 'skip-meeting') dates.add(date);
    else dates.delete(date);
    const { error: skipError } = await supabase.from('project_meetings').update({ skip_dates: [...dates].sort() }).eq('id', meetingId).eq('project_id', id);
    if (skipError) return bounce({ error: 'invalid' });
    if (intent === 'skip-meeting') await chat(`🚫 ${who} cancelled “${current.title}” on ${date}`);
    return bounce({ notice: 'saved' });
  }

  if (intent === 'extend-meeting') {
    // Run the series another 30 days from its end date (or from today if it already ended).
    const meetingId = String(form.get('meeting_id') ?? '');
    const { data: current } = await supabase.from('project_meetings').select('ends_on, time_zone, title').eq('id', meetingId).eq('project_id', id).maybeSingle();
    if (!current) return bounce({ error: 'not-found' });
    const today = zonedDate(String(current.time_zone || 'Asia/Bangkok'), Date.now()).date;
    const base = current.ends_on && current.ends_on > today ? String(current.ends_on) : today;
    const { error: extendError } = await supabase.from('project_meetings').update({ ends_on: addDays(base, DEFAULT_RUN_DAYS) }).eq('id', meetingId).eq('project_id', id);
    if (extendError) return bounce({ error: 'invalid' });
    await track('update', `meeting extended: ${current.title}`);
    return bounce({ notice: 'saved' });
  }

  if (intent === 'delete-meeting') {
    const meetingId = String(form.get('meeting_id') ?? '');
    const { error: deleteError } = await supabase.from('project_meetings').delete().eq('id', meetingId).eq('project_id', id);
    if (deleteError) return bounce({ error: 'invalid' });
    await track('delete', 'meeting');
    return bounce({ notice: 'deleted' });
  }

  if (intent === 'start-timer') {
    const taskId = String(form.get('task_id') ?? '');
    const result = await startTimer(supabase, taskId, actor);
    return result.error ? bounce({ error: result.error }) : bounce({});
  }

  if (intent === 'stop-timer') {
    await stopTimer(supabase, actor);
    return bounce({});
  }

  if (intent === 'log-time') {
    const result = await logTime(supabase, form, actor);
    if (result.error) return bounce({ error: 'invalid' });
    await logTaskEvent(supabase, String(form.get('task_id') ?? ''), actor, 'time', formatMinutes(result.minutes));
    return bounce({});
  }

  if (intent === 'delete-time') {
    const result = await removeTime(supabase, form, id);
    return result.error ? bounce({ error: result.error }) : bounce({});
  }

  if (intent === 'apply-checklist') {
    const taskId = String(form.get('task_id') ?? '');
    const result = await applyChecklist(supabase, taskId, String(form.get('template_id') ?? ''));
    if (result.error) return bounce({ error: 'invalid' });
    await logTaskEvent(supabase, taskId, actor, 'subtask_add', `${result.count} checklist items`);
    return bounce({});
  }

  if (intent === 'apply-qa-checklist') {
    const taskId = String(form.get('task_id') ?? '');
    const result = await applyQaChecklist(supabase, taskId, String(form.get('template_id') ?? ''), id);
    if (result.error) return bounce({ error: result.error });
    await logTaskEvent(supabase, taskId, actor, 'subtask_add', `${result.count} QA checklist items`);
    const { data: target } = await supabase.from('project_tasks').select('title').eq('id', taskId).maybeSingle();
    await notify(supabase, actor, result.assignees, {
      kind: 'assigned',
      projectId: id,
      taskId,
      title: String(target?.title ?? 'a task'),
      body: 'QA checklist assigned — check your items before this task can be completed.',
    });
    for (const email of result.assignees) await follow(supabase, taskId, email);
    return bounce({ notice: 'saved' });
  }

  if (intent === 'add-qa-list') {
    const result =
      String(form.get('from_template') ?? '') === '1' || form.get('template_id')
        ? await createQaChecklistFromTemplate(supabase, form, id, actor)
        : await createQaChecklist(supabase, form, id, actor);
    if (result.error) return bounce({ error: result.error });
    await notify(supabase, actor, result.assignees, {
      kind: 'assigned',
      projectId: id,
      title: result.title ?? 'QA checklist',
      body: 'A QA checklist was assigned to you — check your items.',
    });
    await track('qa-list', result.title ?? '', 'project');
    return bounce({ notice: 'created' });
  }

  if (intent === 'add-qa-items') {
    const result = await addQaItems(supabase, form, id);
    if (result.error) return bounce({ error: result.error });
    await notify(supabase, actor, result.assignees, {
      kind: 'assigned',
      projectId: id,
      title: 'QA checklist',
      body: 'New QA checklist items were assigned to you.',
    });
    return bounce({ notice: 'saved' });
  }

  if (intent === 'toggle-qa-check') {
    const result = await toggleQaCheck(supabase, form, id, actor, caps.canPlan);
    if (result.error) return bounce({ error: result.error });
    return bounce({});
  }

  if (intent === 'delete-qa-check') {
    const result = await removeQaCheck(supabase, form, id);
    return result.error ? bounce({ error: result.error }) : bounce({ notice: 'deleted' });
  }

  if (intent === 'delete-qa-list') {
    const result = await removeQaChecklist(supabase, form, id);
    return result.error ? bounce({ error: result.error }) : bounce({ notice: 'deleted' });
  }

  if (intent === 'report-bug') {
    const title = String(form.get('title') ?? '').trim().slice(0, 200);
    if (!title) return bounce({ error: 'invalid' });
    const severity = String(form.get('severity') ?? 'minor');
    const priority = severity === 'critical' ? 'high' : severity === 'major' ? 'medium' : 'low';
    const section = (label: string, key: string) => {
      const value = String(form.get(key) ?? '').trim();
      return value ? `${label}:\n${value}` : '';
    };
    const notes = [
      `Severity: ${severity}`,
      section('Steps to reproduce', 'steps'),
      section('Expected', 'expected'),
      section('Actual', 'actual'),
      section('Device / browser', 'device'),
    ]
      .filter(Boolean)
      .join('\n\n')
      .slice(0, 4000);
    const milestoneRaw = String(form.get('milestone_id') ?? '').trim();
    const { data: created, error: bugError } = await supabase
      .from('project_tasks')
      .insert({
        project_id: id,
        title,
        notes,
        kind: 'bug',
        priority,
        milestone_id: milestoneRaw || null,
        assignee_email: String(form.get('assignee_email') ?? '').trim().toLowerCase(),
        created_by_email: actor,
        status: 'todo',
      })
      .select('id')
      .single();
    if (bugError || !created) {
      console.error('bug report failed', bugError?.message);
      return bounce({ error: 'invalid' });
    }
    const bugId = String(created.id);
    await follow(supabase, bugId, actor);
    const shot = form.get('file');
    if (shot instanceof File && shot.size > 0) {
      const fileForm = new FormData();
      fileForm.set('task_id', bugId);
      fileForm.set('file', shot);
      const attached = await addFileAttachment(supabase, fileForm, id, actor);
      if (attached.error) console.error('bug screenshot failed', attached.error);
    }
    await track('create', `Bug: ${title}`, 'task');
    // Tell the project's leads and managers (or the assignee).
    const { data: planners } = await supabase.from('project_members').select('email, roles').eq('project_id', id);
    const recipients = ((planners ?? []) as { email: string; roles: string[] }[])
      .filter((row) => row.roles?.includes('lead') || row.roles?.includes('manager'))
      .map((row) => row.email);
    const assignee = String(form.get('assignee_email') ?? '').trim().toLowerCase();
    await notify(supabase, actor, assignee ? [assignee, ...recipients] : recipients, {
      kind: 'bug',
      projectId: id,
      taskId: bugId,
      title,
      body: `${severity[0].toUpperCase()}${severity.slice(1)} bug`,
    });
    await chat(`🐞 ${who} reported a ${severity} bug: “${title}”`, `/team/projects/${id}?tab=tasks&task=${bugId}`);
    return Astro.redirect(projectHref(id, { tab: 'tasks', task: bugId, notice: 'created' }));
  }

  if (intent === 'save-template') {
    const name = String(form.get('template_name') ?? '').trim();
    if (!name) return bounce({ error: 'invalid' });
    const result = await saveProjectAsTemplate(supabase, id, name, actor);
    return result.error ? bounce({ error: result.error }) : bounce({ notice: 'saved' });
  }

  if (intent === 'update-chat') {
    const parsed = parseWebhookUrl(String(form.get('chat_webhook_url') ?? ''));
    if (parsed === null) return bounce({ error: 'webhook' });
    const { error: hookError } = await supabase.from('projects').update({ chat_webhook_url: parsed }).eq('id', id);
    if (hookError) return bounce({ error: 'invalid' });
    await track('update', parsed ? 'chat notifications on' : 'chat notifications off');
    if (parsed && form.get('test') === '1') await chat(`👋 ${who} connected this project's team notifications.`);
    return bounce({ notice: 'saved' });
  }

  if (intent === 'share-create') {
    const { error: shareError } = await supabase
      .from('project_share_links')
      .upsert({ project_id: id, created_by: actor }, { onConflict: 'project_id', ignoreDuplicates: true });
    if (shareError) return bounce({ error: 'invalid' });
    await track('update', 'client link created');
    return bounce({ notice: 'saved' });
  }

  if (intent === 'share-reset') {
    await supabase.from('project_share_links').delete().eq('project_id', id);
    const { error: shareError } = await supabase.from('project_share_links').insert({ project_id: id, created_by: actor });
    if (shareError) return bounce({ error: 'invalid' });
    await track('update', 'client link reset');
    return bounce({ notice: 'saved' });
  }

  if (intent === 'share-checkin') {
    const show = String(form.get('show_checkin') ?? '') === '1';
    await supabase.from('project_share_links').update({ show_checkin: show }).eq('project_id', id);
    return bounce({ notice: 'saved' });
  }

  if (intent === 'share-delete') {
    await supabase.from('project_share_links').delete().eq('project_id', id);
    await track('update', 'client link turned off');
    return bounce({ notice: 'deleted' });
  }

  if (intent === 'delete-task') {
    const taskId = String(form.get('task_id') ?? '');
    if (!taskId) return bounce({ error: 'invalid' });
    const result = await removeTask(supabase, taskId, id);
    if (result.error) return bounce({ error: 'invalid' });
    await track('delete', '', 'task');
    return bounce({ notice: 'deleted' });
  }

  if (intent === 'add-checkin') {
    const result = await addCheckin(supabase, form, id, actor);
    if (result.error) return bounce({ error: result.error });
    await chat(`📍 ${who} checked in: ${String(form.get('body') ?? '').trim().slice(0, 300)}`, `/team/projects/${id}?tab=schedule#checkin`);
    await track('create', String(form.get('body') ?? '').trim().slice(0, 80), 'checkin');
    return bounce({ notice: 'created' });
  }

  if (intent === 'delete-checkin') {
    const checkinId = String(form.get('checkin_id') ?? '');
    if (!checkinId) return bounce({ error: 'invalid' });
    if (!caps.canPlan) {
      const { data: note } = await supabase
        .from('project_checkins')
        .select('author_email')
        .eq('id', checkinId)
        .eq('project_id', id)
        .maybeSingle();
      if (note?.author_email !== actor) return bounce({ error: 'forbidden' });
    }
    const result = await removeCheckin(supabase, checkinId, id);
    if (result.error) return bounce({ error: 'invalid' });
    await track('delete', '', 'checkin');
    return bounce({ notice: 'deleted' });
  }

  if (intent === 'add-member') {
    const email = String(form.get('email') ?? '').trim().toLowerCase();
    const roles = rolesFromForm(form);
    if (!email || roles.length === 0) return bounce({ error: 'invalid' });
    const { error } = await supabase.from('project_members').insert({ project_id: id, email, roles });
    if (error) {
      if (error.code === '23505') return bounce({ error: 'duplicate' });
      console.error(error.message);
      return bounce({ error: 'invalid' });
    }
    await track('member_add', email);
    if (form.get('send_invite') === '1') {
      const { data: named } = await supabase.from('projects').select('name').eq('id', id).maybeSingle();
      const labels = ROLE_META.filter((role) => roles.includes(role.id)).map((role) => role.label);
      const mail = await sendProjectInvite(email, named?.name ?? 'a project', labels, Astro.request);
      return bounce({ notice: mail.error ? 'added-no-mail' : 'added-invited' });
    }
    return bounce({ notice: 'created' });
  }

  if (intent === 'update-member') {
    const email = String(form.get('email') ?? '').trim().toLowerCase();
    const roles = rolesFromForm(form);
    if (!email || roles.length === 0) return bounce({ error: 'invalid' });
    const { data: crewNow } = await supabase.from('project_members').select('email, roles').eq('project_id', id);
    if (wouldDropLastLead((crewNow ?? []) as ProjectMemberRow[], email, roles)) {
      return bounce({ error: 'keep-lead' });
    }
    const { error } = await supabase.from('project_members').update({ roles }).eq('project_id', id).eq('email', email);
    if (error) return bounce({ error: 'invalid' });
    await track('member_update', email);
    return bounce({ notice: 'saved' });
  }

  if (intent === 'remove-member') {
    const email = String(form.get('email') ?? '').trim().toLowerCase();
    if (!email) return bounce({ error: 'invalid' });
    const { data: crewNow } = await supabase.from('project_members').select('email, roles').eq('project_id', id);
    if (wouldDropLastLead((crewNow ?? []) as ProjectMemberRow[], email, null)) {
      return bounce({ error: 'keep-lead' });
    }
    const { error } = await supabase.from('project_members').delete().eq('project_id', id).eq('email', email);
    if (error) return bounce({ error: 'invalid' });
    await track('member_remove', email);
    return bounce({ notice: 'deleted' });
  }

  if (!revealedLogin) {
    if (!user?.id) return bounce({ error: 'invalid' });
    const payload = projectFromForm(form);
    const hub = hubFromForm(form);
    if (!payload || !hub) return bounce({ error: 'invalid' });
    const { data: current } = await supabase
      .from('projects')
      .select('logo_url, login_password_enc')
      .eq('id', id)
      .maybeSingle();
    const logo = await logoFromForm(form, supabase, user.id, current?.logo_url ?? '');
    if ('error' in logo) return bounce({ error: logo.error });
    const password = loginPasswordFromForm(form, current?.login_password_enc ?? '');
    if ('error' in password) return bounce({ error: password.error });
    const { error } = await supabase.from('projects').update({ ...payload, ...hub, ...logo, ...password }).eq('id', id);
    if (error) {
      console.error(error.message);
      return bounce({ error: 'invalid' });
    }
    await track('update', payload.name);
    return bounce({ notice: 'saved' });
  }
}

const tab = pickTab(Astro.url.searchParams.get('tab'), caps);
const action = Astro.url.searchParams.get('action') ?? '';
const calCursor = parseMonth(Astro.url.searchParams.get('month'), new Date());
const taskParam = caps.canSchedule ? (Astro.url.searchParams.get('task') ?? '').trim() : '';
const taskView = Astro.url.searchParams.get('view') === 'board' ? 'board' : 'list';
const taskWho = (Astro.url.searchParams.get('who') ?? '').trim().toLowerCase();
// The header shows funding, team, and open work on every tab, so these load everywhere.
const needMoney = caps.canFinance;
const needMembers = true;
const needCrew = true;
const none = { data: [] as never[] };

const [
  { data: project, error },
  { data: milestoneRows },
  { data: taskRows },
  { data: checkinRows },
  { data: entryRows },
  { data: contribRows },
  { data: memberRows },
  { data: crewRows },
  counts,
  detail,
  dependencies,
  views,
  timeEntries,
  checklists,
  { data: shareLink },
  { data: projectTime },
  meetings,
  mine,
  qaLists,
] = await Promise.all([
  supabase.from('projects').select('*').eq('id', id).maybeSingle(),
  supabase.from('project_milestones').select('*').eq('project_id', id).order('sort_order'),
  tab === 'schedule' || tab === 'tasks'
    ? supabase.from('project_tasks').select('*').eq('project_id', id)
    : supabase.from('project_tasks').select('id, status, due_on').eq('project_id', id).neq('status', 'done'),
  supabase.from('project_checkins').select('*').eq('project_id', id).order('created_at', { ascending: false }).limit(tab === 'schedule' ? 8 : 1),
  needMoney
    ? supabase.from('ledger_entries').select('*').eq('project_id', id).order('occurred_on', { ascending: false })
    : Promise.resolve(none),
  needMoney
    ? supabase.from('project_contributions').select('*').eq('project_id', id).order('occurred_on', { ascending: false })
    : Promise.resolve(none),
  needMembers ? supabase.from('team_members').select('*').order('email') : Promise.resolve(none),
  needCrew
    ? supabase.from('project_members').select('email, roles').eq('project_id', id).order('email')
    : Promise.resolve(none),
  tab === 'tasks' ? taskCounts(supabase, [id]) : Promise.resolve(new Map<string, { subtasks: number; subtasksDone: number; comments: number }>()),
  taskParam ? taskDetail(supabase, id, taskParam) : Promise.resolve(null),
  tab === 'tasks' || taskParam ? projectDependencies(supabase, id) : Promise.resolve([]),
  tab === 'tasks' ? savedViews(supabase, id) : Promise.resolve([]),
  taskParam ? taskTime(supabase, taskParam) : Promise.resolve([]),
  taskParam || tab === 'qa' ? listTemplates(supabase, 'checklist') : Promise.resolve([]),
  tab === 'details' && caps.lead
    ? supabase.from('project_share_links').select('token, show_checkin, created_at').eq('project_id', id).maybeSingle()
    : Promise.resolve({ data: null }),
  supabase.from('task_time_entries').select('minutes, started_at, ended_at').eq('project_id', id),
  projectMeetings(supabase, [id]),
  // Private notes: never loaded during "View as" (they belong to the real signed-in person).
  Astro.locals.viewAs ? Promise.resolve([]) : personalItems(supabase, id, studio.email),
  tab === 'qa' ? listQaChecklists(supabase, id) : Promise.resolve([]),
]);
if (error || !project) {
  return Astro.redirect('/team/projects?error=not-found');
}

const row = project as Project;
const entries = (entryRows ?? []) as LedgerEntry[];
const contributions = (contribRows ?? []) as Contribution[];
const members = (memberRows ?? []) as TeamMember[];
const milestones = sortMilestones((milestoneRows ?? []) as Milestone[]);
const tasks = (taskRows ?? []) as ProjectTask[];
const checkins = (checkinRows ?? []) as ProjectCheckin[];
const latestCheckin = checkins[0] ?? null;
const crew = (crewRows ?? []) as ProjectMemberRow[];
const onProject = new Set(crew.map((person) => person.email));
const taskPeople = members.filter((member) => onProject.has(member.email));
const qaEmails = crew
  .filter((person) => parseRoles(person.roles).includes('qa'))
  .map((person) => person.email.trim().toLowerCase())
  .filter(Boolean)
  .sort();
const invitees = members.filter((member) => !onProject.has(member.email));
const totals = totalsByCurrency(entries);
const expenses = entries.filter((entry) => entry.kind === 'expense');
const funding = fundingByCurrency(contributions, expenses);
const byMember = contributionsByMember(contributions);
const txs = fundTransactions(contributions, expenses, fundViewer);
const primaryFund = funding[0];
const fundRemaining = funding.map((item) => money(item.remaining, item.currency)).join(' · ');
const fundIn = funding.map((item) => money(item.funded, item.currency)).join(' · ');
const fundOut = funding.map((item) => money(item.spent, item.currency)).join(' · ');
const slipsPromise = voucherHrefs(supabase, [
  ...(tab === 'funding' || tab === 'ledger'
    ? [...entries, ...contributions.map((item) => ({ voucher_url: item.voucher_url }))]
    : []),
  { voucher_url: row.qr_url },
  { voucher_url: row.logo_url },
  ...(tab === 'schedule' || tab === 'tasks' ? tasks.map((item) => ({ voucher_url: item.image_url })) : []),
  ...(detail ? [{ voucher_url: detail.task.image_url }] : []),
]);
const [slips, attachHrefs] = await Promise.all([
  slipsPromise,
  detail ? attachmentHrefs(supabase, detail.attachments) : Promise.resolve(new Map<string, string>()),
]);
const qrHref = slips.get(row.qr_url);
const logoHref = slips.get(row.logo_url) ?? '';
const links = projectLinks(row);
const extraLinks = extraLinksOf(row.extra_links);
const editing = action === 'edit' && caps.canEditDetails;
const peopleEditing = tab === 'people' && action === 'edit';
const hasLogin = Boolean(row.login_username || row.login_email || row.login_url || row.login_password_enc);
const extraRows =
  extraLinks.length === 0
    ? [
        { label: '', url: '' },
        { label: '', url: '' },
        { label: '', url: '' },
      ]
    : extraLinks.length >= 8
      ? extraLinks
      : [...extraLinks, { label: '', url: '' }];
const loginPassword = revealedLogin ? decryptSecret(row.login_password_enc) : '';
const today = todayIso();
const stage = currentStage(milestones);
const mineOpen = mine.filter((item) => item.kind === 'todo' && !item.done).length;
const { done: stagesDone, total: stagesTotal, allDone: allStagesDone, pct: stagePct } = stageCounts(milestones);
const stageLate = Boolean(!allStagesDone && stage?.estimated_on && stage.estimated_on < today);
const openTasks = tasks.filter((item) => item.status !== 'done');
const lateTasks = openTasks.filter((item) => item.due_on && item.due_on < today);
const crewFaces = crew.map((person) => personFace(person.email, members));
const awayEmails = new Set(members.filter((member) => availabilityOf(member).away).map((member) => member.email));
const awayTag = (email: string) => (awayEmails.has(email) ? ' (away)' : '');
const health = projectHealth({
  status: row.status,
  today,
  stages: milestones,
  tasks,
  lastCheckin: latestCheckin?.created_at ?? null,
  funding: caps.canFinance ? funding : null,
});
const weekAgoIso = new Date(Date.now() - 7 * 86_400_000).toISOString();
const timeRows = (projectTime ?? []) as { minutes: number; started_at: string; ended_at: string | null }[];
const loggedMinutes = timeRows.reduce((sum, entry) => sum + (entry.minutes || 0), 0);
const weekMinutes = timeRows.filter((entry) => entry.started_at >= weekAgoIso).reduce((sum, entry) => sum + (entry.minutes || 0), 0);
const nowMs = Date.now();
const viewerZone = studio.timeZone;
const todayLocal = zonedDate(viewerZone, nowMs).date;
const zoneChoices = TIME_ZONES.includes(viewerZone) ? TIME_ZONES : [viewerZone, ...TIME_ZONES];
const meetingRows = meetings as ProjectMeeting[];
const meetingNext = meetingRows
  .map((meeting) => nextOccurrence(meeting, nowMs))
  .filter((o): o is NonNullable<typeof o> => Boolean(o))
  .sort((a, b) => a.start - b.start);
const nextMeeting = meetingNext[0] ?? null;
const meetingSoon = Boolean(nextMeeting && nextMeeting.start - nowMs < 60 * 60_000);
const meetingLive = Boolean(nextMeeting && nowMs >= nextMeeting.start && nowMs < nextMeeting.end);
const shareUrl = shareLink?.token ? `${siteUrl(Astro.request)}/p/${shareLink.token}` : '';
function shortDate(iso: string) {
  return new Date(`${iso}T12:00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<Team title={row.name}>
  <div class="wrap team-page">
    <header class="pd-hero">
      <div class="pd-top">
        <ProjectMark name={row.name} src={logoHref} size="lg" />
        <div class="pd-name">
          <p class="kicker"><a href="/team/projects">Projects</a></p>
          <h1>
            {row.name}
            <em class:list={['ov-status', row.status]}>{row.status}</em>
            {health.level !== 'idle' && (
              <span class:list={['health-badge', health.level]} title={health.reasons.join(' · ') || 'Everything on schedule'}>
                <i aria-hidden="true" />
                {health.label}
              </span>
            )}
          </h1>
          <p class="pd-sub">
            {row.client || 'No client recorded'}
            {row.started_on ? ` · started ${shortDate(row.started_on)}` : ''}
            <span class="pd-role">{caps.roleLabels.join(' · ') || 'Viewer'}</span>
          </p>
          {health.reasons.length > 0 && <p class:list={['health-reasons', health.level]}>{health.reasons.join(' · ')}</p>}
        </div>
        <div class="pd-top-side">
          {crewFaces.length > 0 && (
            <a class="pd-crew" href={projectHref(row.id, { tab: caps.canPeople ? 'people' : tab })} title="Team on this project">
              <FacePile people={crewFaces} label="Team" limit={5} />
              <span>{crewFaces.length} on team</span>
            </a>
          )}
          {!nextMeeting && row.meeting_url && (
            <a class="btn" href={websiteHref(row.meeting_url)} target="_blank" rel="noopener noreferrer" data-astro-reload>
              Join meeting
            </a>
          )}
        </div>
      </div>

      {
        nextMeeting && (
          <div class:list={['pd-meeting', meetingSoon && 'is-soon', meetingLive && 'is-live']} data-meeting-start={nextMeeting.start} data-meeting-end={nextMeeting.end}>
            <span class="pd-meeting-icon" aria-hidden="true">{meetingLive ? '●' : '📅'}</span>
            <span class="pd-meeting-copy">
              <strong>{nextMeeting.meeting.title}</strong>
              <span>
                {whenLabel(nextMeeting, viewerZone, nowMs)} ·{' '}
                <span class="pd-meeting-rel" data-meeting-rel>{relativeLabel(nextMeeting.start, nextMeeting.end, nowMs)}</span>
                {meetingNext.length > 1 && <span class="muted"> · then {whenLabel(meetingNext[1], viewerZone, nowMs)}</span>}
              </span>
            </span>
            <span class="pd-meeting-actions">
              <a class="btn" href={meetingHref(nextMeeting.meeting.meeting_url)} target="_blank" rel="noopener noreferrer" data-astro-reload>
                {meetingLive ? 'Join now' : 'Join'}
              </a>
              {nextMeeting.meeting.backup_url && (
                <a class="btn btn-ghost" href={meetingHref(nextMeeting.meeting.backup_url)} target="_blank" rel="noopener noreferrer" data-astro-reload>
                  Backup link
                </a>
              )}
            </span>
          </div>
        )
      }

      {
        links.length > 0 && (
          <nav class="project-links" aria-label="Project links">
            {links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        )
      }

      <dl class="pd-stats">
        <div class:list={['pd-stat', stageLate && 'is-late']}>
          <dt>Current stage</dt>
          <dd>
            <strong>{allStagesDone ? 'All done' : stage?.title ?? 'No stages yet'}</strong>
            <span>
              {allStagesDone
                ? 'Every stage is complete'
                : stage?.estimated_on
                  ? `${stageLate ? 'Late · was due ' : 'Due '}${shortDate(stage.estimated_on)}`
                  : 'No date set'}
            </span>
          </dd>
        </div>
        <div class="pd-stat">
          <dt>Progress</dt>
          <dd>
            <strong>{stagesDone} of {stagesTotal}</strong>
            <span class="pj-progress" role="img" aria-label={`${stagePct}% of stages done`}>
              <span style={`width:${stagePct}%`} />
            </span>
          </dd>
        </div>
        <div class:list={['pd-stat', lateTasks.length > 0 && 'is-late']}>
          <dt>Open tasks</dt>
          <dd>
            <strong>{openTasks.length}</strong>
            <span>{lateTasks.length > 0 ? `${lateTasks.length} late` : openTasks.length === 0 ? 'Nothing open' : 'None late'}</span>
          </dd>
        </div>
        <div class="pd-stat">
          <dt>Time logged</dt>
          <dd>
            <strong>{formatMinutes(loggedMinutes)}</strong>
            <span>{weekMinutes > 0 ? `${formatMinutes(weekMinutes)} this week` : 'Nothing this week'}</span>
          </dd>
        </div>
        {
          caps.canFinance && (
            <div class="pd-stat is-money">
              <dt>Funding left</dt>
              <dd>
                <strong>{primaryFund ? fundRemaining : '—'}</strong>
                <span>{primaryFund ? `${fundIn} in · ${fundOut} out` : 'No team funding yet'}</span>
              </dd>
            </div>
          )
        }
      </dl>

      {
        latestCheckin && (
          <a class="pd-now" href={`${projectHref(row.id, { tab: 'schedule' })}#checkin`}>
            <span class="pd-now-tag">Now</span>
            <span class="pd-now-body">{latestCheckin.body}</span>
            <span class="pd-now-meta">
              {personLabel(latestCheckin.author_email, members)} · {shortDate(latestCheckin.created_at.slice(0, 10))}
            </span>
          </a>
        )
      }
    </header>

    <TeamFlash />

    <div class="pd-bar">
      <nav class="project-tabs" aria-label="Project sections">
        {
          caps.tabs.map((item) => (
            <a href={projectHref(row.id, { tab: item.id })} data-astro-prefetch="hover" aria-current={tab === item.id ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <nav class="pd-actions" aria-label="Quick actions">
        {
          caps.canProgress && (
            <a class="btn btn-ghost" href={projectHref(row.id, { tab: 'schedule', action: 'checkin' })} data-modal-open="checkin">
              Check-in
            </a>
          )
        }
        {
          caps.canPlan && (
            <a class="btn btn-ghost" href={projectHref(row.id, { tab: 'schedule', action: 'task' })} data-modal-open="task">+ Task</a>
          )
        }
        {
          caps.canFinance && (
            <>
              <a class="btn btn-ghost" href={projectHref(row.id, { tab: 'funding', action: 'contribute' })} data-modal-open="funding">+ Funding</a>
              <a class="btn btn-ghost" href={projectHref(row.id, { tab: 'ledger', action: 'expense' })} data-modal-open="entry">+ Expense</a>
            </>
          )
        }
        {
          !Astro.locals.viewAs && (
            <span class="pd-mine" role="group" aria-label="My private notes">
              <a class="btn btn-ghost" href={projectHref(row.id, { tab, action: 'mine' })} data-modal-open="mine" data-mine-open="todo" title="Private to-do, only you see it (T)" aria-keyshortcuts="T">
                ☐ To-do<span class="pd-mine-badge" data-mine-badge>{mineOpen || ''}</span>
              </a>
              <a class="btn btn-ghost" href={projectHref(row.id, { tab, action: 'mine' })} data-modal-open="mine" data-mine-open="note" title="Private note, only you see it (N)" aria-keyshortcuts="N">✎ Note</a>
            </span>
          )
        }
        <details class="pd-more">
          <summary class="btn btn-ghost" aria-label="More actions">More</summary>
          <div class="pd-menu">
            {caps.canFinance && <a href={`${projectHref(row.id, { tab: 'funding' })}#pay`}>Pay details</a>}
            {caps.canPeople && <a href={projectHref(row.id, { tab: 'people', action: 'invite' })} data-modal-open="person">Add person</a>}
            {caps.canPlan && <a href={projectHref(row.id, { tab: 'schedule', action: 'stage' })} data-modal-open="stage">Add stage</a>}
            {caps.canDetails && (
              <a href={projectHref(row.id, { tab: 'details', action: caps.canEditDetails ? 'edit' : undefined })}>
                {caps.canEditDetails ? 'Edit workspace' : 'Links and login'}
              </a>
            )}
            {caps.canProgress && <a href={projectHref(row.id, { tab: 'tasks', action: 'bug' })} data-modal-open="bug">Report a bug</a>}
            {caps.canPlan && <a href={projectHref(row.id, { tab: 'schedule', action: 'template' })} data-modal-open="template">Save as template</a>}
            <a href="/team/projects">All projects</a>
          </div>
        </details>
      </nav>
    </div>

    <div class="project-panel">
      {
        tab === 'schedule' && (
          <>
            {(meetingRows.length > 0 || (caps.canPlan && !Astro.locals.viewAs)) && (
              <section class="team-card mt-card" id="meetings">
                <div class="card-head">
                  <div class="pay-head">
                    <h2>Meetings</h2>
                    <p class="muted">{meetingRows.length === 0 ? 'Set a regular time and link so the team always knows when to join.' : 'Everyone on this project sees these and gets a reminder banner 30 minutes before.'}</p>
                  </div>
                  {caps.canPlan && !Astro.locals.viewAs && (
                    <a class="btn btn-ghost card-add" href={projectHref(row.id, { tab: 'schedule', action: 'meeting' })} data-modal-open="meeting">+ {meetingRows.length ? 'Add meeting' : 'Set up meeting'}</a>
                  )}
                </div>
                <ul class="mt-list">
                  {meetingRows.map((meeting) => {
                    const next = nextOccurrence(meeting, nowMs);
                    const live = Boolean(next && nowMs >= next.start && nowMs < next.end);
                    return (
                      <li class:list={['mt-item', live && 'is-live']}>
                        <div class="mt-main">
                          <strong>{meeting.title}</strong>
                          <span class="muted">{scheduleLabel(meeting, viewerZone, nowMs)} · {meeting.duration_minutes} min · your time</span>
                          {!sameClock(viewerZone, meeting.time_zone, nowMs) && (
                            <span class="mt-zone">Set in {zoneName(meeting.time_zone)} time: {scheduleLabel(meeting)}</span>
                          )}
                          {(() => {
                            const left = daysLeft(meeting, nowMs);
                            if (left === null) return null;
                            const until = new Date(`${meeting.ends_on}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
                            return (
                              <span class:list={['mt-until', left === 0 ? 'is-ended' : left <= 7 && 'is-ending']}>
                                {left === 0 ? `Ended ${until}` : `Until ${until}${left <= 7 ? ` · ${left} ${left === 1 ? 'day' : 'days'} left` : ''}`}
                                {left <= 7 && caps.canPlan && !Astro.locals.viewAs && (
                                  <form method="post">
                                    <input type="hidden" name="intent" value="extend-meeting" />
                                    <input type="hidden" name="meeting_id" value={meeting.id} />
                                    <button type="submit" class="ms-text">Extend 30 days</button>
                                  </form>
                                )}
                              </span>
                            );
                          })()}
                          {next && (
                            <span class="mt-next" data-meeting-start={next.start} data-meeting-end={next.end}>
                              Next: {whenLabel(next, viewerZone, nowMs)} · <span data-meeting-rel>{relativeLabel(next.start, next.end, nowMs)}</span>
                            </span>
                          )}
                          {meeting.notes && <span class="mt-notes">{meeting.notes}</span>}
                          {meeting.skip_dates.length > 0 && (
                            <span class="mt-skipped">
                              Cancelled: {meeting.skip_dates.map((d) => (
                                <span>
                                  {new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' })}
                                  {caps.canPlan && !Astro.locals.viewAs && (
                                    <form method="post">
                                      <input type="hidden" name="intent" value="unskip-meeting" />
                                      <input type="hidden" name="meeting_id" value={meeting.id} />
                                      <input type="hidden" name="date" value={d} />
                                      <button type="submit" title="Restore this session" aria-label="Restore this session">↺</button>
                                    </form>
                                  )}
                                </span>
                              ))}
                            </span>
                          )}
                        </div>
                        <div class="mt-actions">
                          <a class="btn" href={meetingHref(meeting.meeting_url)} target="_blank" rel="noopener noreferrer" data-astro-reload>Join</a>
                          {meeting.backup_url && (
                            <a class="btn btn-ghost" href={meetingHref(meeting.backup_url)} target="_blank" rel="noopener noreferrer" data-astro-reload>Backup</a>
                          )}
                          {caps.canPlan && !Astro.locals.viewAs && (
                            <details class="pd-more mt-more">
                              <summary class="btn btn-ghost" aria-label="Meeting options">•••</summary>
                              <div class="pd-menu">
                                <a href={projectHref(row.id, { tab: 'schedule' })} data-modal-open={`meeting-${meeting.id}`}>Edit</a>
                                <form method="post">
                                  <input type="hidden" name="intent" value="extend-meeting" />
                                  <input type="hidden" name="meeting_id" value={meeting.id} />
                                  <button type="submit">Extend 30 days</button>
                                </form>
                                {next && (
                                  <form method="post" data-confirm={`Cancel the session on ${whenLabel(next, viewerZone, nowMs)}?`} data-confirm-action="Cancel session">
                                    <input type="hidden" name="intent" value="skip-meeting" />
                                    <input type="hidden" name="meeting_id" value={meeting.id} />
                                    <input type="hidden" name="date" value={next.localDate} />
                                    <button type="submit">Cancel next session</button>
                                  </form>
                                )}
                                <form method="post" data-confirm={`Delete “${meeting.title}” and all its sessions?`} data-confirm-action="Delete">
                                  <input type="hidden" name="intent" value="delete-meeting" />
                                  <input type="hidden" name="meeting_id" value={meeting.id} />
                                  <button type="submit" class="td-delete">Delete meeting</button>
                                </form>
                              </div>
                            </details>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </section>
            )}
            <MilestoneTrack
              milestones={milestones}
              openAdd={action === 'stage'}
              canPlan={caps.canPlan}
              canProgress={caps.canProgress}
            />
            <section class="team-card task-card">
              <div class="card-head">
                <div class="pay-head">
                  <h2>Tasks</h2>
                  <p class="muted">
                    {openTasks.length} open{lateTasks.length > 0 ? ` · ${lateTasks.length} late` : ''}
                  </p>
                </div>
                <a class="btn btn-ghost card-add" href={projectHref(row.id, { tab: 'tasks' })}>Open tasks →</a>
              </div>
              {openTasks.length === 0 ? (
                <p class="muted">Nothing open. {caps.canPlan && 'Add the next slice of work from the Tasks tab.'}</p>
              ) : (
                <ul class="tw-rows tw-mini">
                  {sortTaskQueue(openTasks).slice(0, 5).map((item) => (
                    <li class:list={['tw-row', taskIsLate(item, today) && 'is-late']}>
                      <a class="tw-title" href={projectHref(row.id, { tab: 'tasks', task: item.id })}>
                        <span>{item.title}</span>
                      </a>
                      <span class="tw-meta">
                        <span class:list={['tw-due', taskIsLate(item, today) && 'late']}>{item.due_on ? shortDate(item.due_on) : ''}</span>
                        <span class="tw-who-name">{item.assignee_email ? personLabel(item.assignee_email, members) : 'Unassigned'}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
            <CheckIn
              latest={latestCheckin}
              recent={checkins}
              people={taskPeople}
              canPost={caps.canProgress}
              canRemove={caps.canPlan}
              actorEmail={studio.email}
              openPost={action === 'checkin'}
            />
            <ProjectCalendar
              cursor={calCursor}
              today={today}
              startedOn={row.started_on}
              milestones={milestones}
              tasks={tasks}
              contributions={contributions}
              entries={entries}
              meetings={meetingRows}
              zone={viewerZone}
              monthHref={(month) => projectHref(row.id, { tab: 'schedule', month })}
              showMoney={caps.canFinance}
            />
          </>
        )
      }

      {
        tab === 'tasks' && (
          <TaskWorkspace
            tasks={tasks}
            milestones={milestones}
            people={members}
            counts={counts}
            view={taskView}
            who={taskWho}
            viewerEmail={studio.email}
            today={today}
            canPlan={caps.canPlan}
            canProgress={caps.canProgress}
            readOnly={Boolean(Astro.locals.viewAs)}
            base={projectHref(row.id, { tab: 'tasks' })}
            dependencies={dependencies}
            savedViews={views}
            params={Astro.url.searchParams}
            milestoneDates={milestones}
          />
        )
      }

      {
        tab === 'qa' && (
          <QaChecklistWorkspace
            lists={qaLists}
            people={members}
            qaEmails={qaEmails}
            checklists={checklists}
            canPlan={caps.canPlan}
            canProgress={caps.canProgress}
            readOnly={Boolean(Astro.locals.viewAs)}
            viewerEmail={studio.email}
            who={taskWho}
            peopleHref={projectHref(row.id, { tab: 'people' })}
          />
        )
      }

      {
        tab === 'funding' && (
          <>
    <div class="fund-layout">
      <div class="fund-main">

        <section class="team-card">
          <div class="card-head">
            <div class="pay-head">
              <h2>Team funding</h2>
              <p class="muted">
                Current total {primaryFund ? fundRemaining : money(0, 'THB')}. Contributions in, expenses out.
              </p>
            </div>
            <a class="btn btn-ghost card-add" href={projectHref(row.id, { tab: 'funding', action: 'contribute' })} data-modal-open="funding">+ Record funding</a>
          </div>

          <FundingPie contributions={contributions} />

          {
            byMember.length > 0 && (
              <ul class="contrib-people">
                {byMember.map((member) => (
                  <li>
                    <span class="contrib-avatar" aria-hidden="true">
                      {member.email.slice(0, 1).toUpperCase()}
                    </span>
                    <span>
                      <strong>{member.email}</strong>
                      <span>{member.totals.map((total) => money(total.amount, total.currency)).join(' · ')}</span>
                    </span>
                  </li>
                ))}
              </ul>
            )
          }


        </section>

        <section class="team-card">
          <div class="card-head">
            <div class="pay-head">
              <h2>Transactions</h2>
              <p class="muted">{txs.length} {txs.length === 1 ? 'entry' : 'entries'} · newest first</p>
            </div>
            <a class="btn btn-ghost card-add" href={projectHref(row.id, { tab: 'ledger', action: 'expense' })} data-modal-open="entry">+ Expense</a>
          </div>
          {
            txs.length === 0 ? (
              <p class="muted">No transactions yet.</p>
            ) : (
              <ol class="tx-log" aria-label="Fund transactions">
                {txs.map((tx) => (
                  <li class={tx.kind === 'in' ? 'tx-in' : 'tx-out'}>
                    <span>
                      <strong>
                        {tx.kind === 'in' ? '+' : '−'}
                        {money(tx.amount, tx.currency)}
                      </strong>
                      <span>
                        {tx.title} · {tx.date}
                        {tx.detail ? ` · ${tx.detail}` : ''}
                      </span>
                    </span>
                    <div class="tx-actions">
                      <VoucherLink path={tx.voucher_url} href={slips.get(tx.voucher_url)} />
                      {tx.delete && (
                        <form
                          method="post"
                          data-confirm={
                            tx.delete.intent === 'delete-contribution'
                              ? `Remove this contribution of ${money(tx.amount, tx.currency)}?`
                              : `Remove this expense of ${money(tx.amount, tx.currency)}?`
                          }
                        >
                          <input type="hidden" name="tab" value="funding" />
                          <input type="hidden" name="intent" value={tx.delete.intent} />
                          <input
                            type="hidden"
                            name={tx.delete.intent === 'delete-contribution' ? 'contribution_id' : 'entry_id'}
                            value={tx.delete.id}
                          />
                          <button class="btn-text" type="submit">Remove</button>
                        </form>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            )
          }
        </section>
      </div>
      <aside class="fund-side">
        <BankPayCard
          bankName={row.bank_name}
          accountNumber={row.account_number}
          qrHref={qrHref}
          qrPath={row.qr_url}
          remaining={primaryFund ? fundRemaining : money(0, 'THB')}
          funded={primaryFund ? fundIn : money(0, 'THB')}
          spent={primaryFund ? fundOut : money(0, 'THB')}
        />
      </aside>
    </div>
          </>
        )
      }

      {
        tab === 'details' && (
    <section class="team-card">
      <div class="pay-head workspace-head">
        <h2>Workspace</h2>
        {
          caps.canEditDetails && (
            editing ? (
              <a class="btn btn-ghost" href={projectHref(row.id, { tab: 'details' })}>View</a>
            ) : (
              <a class="btn btn-ghost" href={projectHref(row.id, { tab: 'details', action: 'edit' })}>Edit</a>
            )
          )
        }
      </div>
      <p class="muted">Logo, URLs, Slack, and login for this job. Nothing here is published on /work.</p>
      {
        !editing && (
          <>
            <dl class="profile-facts">
              <div>
                <dt>Client</dt>
                <dd>{row.client || '—'}</dd>
              </div>
              <div>
                <dt>Status</dt>
                <dd>{row.status}</dd>
              </div>
              <div>
                <dt>Started</dt>
                <dd>{row.started_on || '—'}</dd>
              </div>
            </dl>
            {row.notes && <p class="hub-notes">{row.notes}</p>}
            {
              links.length > 0 && (
                <div class="fact-list">
                  {links.map((link) => (
                    <div class="fact">
                      <p class="fact-label">{link.label}</p>
                      <p class="fact-body">
                        <a class="fact-value" href={link.href} target="_blank" rel="noopener noreferrer">
                          {link.url}
                        </a>
                      </p>
                    </div>
                  ))}
                </div>
              )
            }
            {
              hasLogin && (
                <>
                  <h3 class="tx-heading">Login</h3>
                  <p class="muted">Password stays hidden until you reveal it. Each reveal is written to Activity.</p>
                  <div class="fact-list">
                    <SecretField id="view_login_user" label="Username" value={row.login_username} />
                    <SecretField id="view_login_email" label="Login email" value={row.login_email} />
                    {row.login_url && (
                      <div class="fact">
                        <p class="fact-label">Login page</p>
                        <p class="fact-body">
                          <a class="fact-value" href={websiteHref(row.login_url)} target="_blank" rel="noopener noreferrer">
                            {row.login_url}
                          </a>
                        </p>
                      </div>
                    )}
                    <SecretField
                      id="view_login_password"
                      label="Password"
                      revealField="password"
                      extras={[{ name: 'tab', value: 'details' }]}
                      hasValue={Boolean(row.login_password_enc)}
