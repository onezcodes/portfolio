---
import Team from '../../layouts/Team.astro';
import { availabilityOf } from '../../lib/presence';
import TeamFlash from '../../components/TeamFlash.astro';
import { emailFromForm } from '../../lib/ledger';
import { logEvent } from '../../lib/events';
import { mailConfigured, sendTeamInvite } from '../../lib/mail';
import { emailOf, SUPER_ADMIN_EMAIL } from '../../lib/supabase';
import { personInitial } from '../../lib/profile';
import { STUDIO_ROLES, STUDIO_ROLE_META, studioRoleOf } from '../../lib/access';

const studio = Astro.locals.studio;
// Owners and admins manage the team; only owners change roles or remove admins/owners.
if (!studio?.superAdmin) {
  return Astro.redirect('/team?error=forbidden');
}
const isOwner = studio.owner;
const canViewAs = Boolean(Astro.locals.realStudio?.owner && !Astro.locals.viewAs);

const supabase = Astro.locals.supabase;
const actor = emailOf(Astro.locals.user);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'add');
  const email = emailFromForm(form.get('email'));
  if (!email) return Astro.redirect('/team/members?error=invalid');

  if (intent === 'set-role') {
    const role = String(form.get('role') ?? '');
    if (!isOwner || email === SUPER_ADMIN_EMAIL || email === actor || !(STUDIO_ROLES as readonly string[]).includes(role)) {
      return Astro.redirect('/team/members?error=forbidden');
    }
    const { error } = await supabase.rpc('set_member_role', { target_email: email, new_role: role });
    if (error) {
      console.error('role change failed', error.message);
      return Astro.redirect('/team/members?error=forbidden');
    }
    await logEvent(supabase, actor, { action: 'role', entityType: 'member', detail: `${email} → ${role}` });
    return Astro.redirect('/team/members?notice=saved');
  }

  if (intent === 'remove') {
    if (email === SUPER_ADMIN_EMAIL || email === actor) {
      return Astro.redirect('/team/members?error=keep-admin');
    }
    // The database also enforces this: admins remove members only.
    const { error, count } = await supabase.from('team_members').delete({ count: 'exact' }).eq('email', email);
    if (error || !count) return Astro.redirect('/team/members?error=forbidden');
    await logEvent(supabase, actor, { action: 'remove', entityType: 'member', detail: email });
    return Astro.redirect('/team/members?notice=removed');
  }

  if (intent === 'invite') {
    if (email === SUPER_ADMIN_EMAIL) {
      return Astro.redirect('/team/members?error=invalid');
    }
    const { data } = await supabase.from('team_members').select('email').eq('email', email).maybeSingle();
    if (!data) return Astro.redirect('/team/members?error=not-found');
    const mail = await sendTeamInvite(email, Astro.request);
    if (mail.error === 'setup') return Astro.redirect('/team/members?error=mail-setup');
    if (mail.error) return Astro.redirect('/team/members?error=mail-failed');
    await logEvent(supabase, actor, { action: 'invite', entityType: 'member', detail: email });
    return Astro.redirect('/team/members?notice=invited');
  }

  if (email === SUPER_ADMIN_EMAIL) {
    return Astro.redirect('/team/members?error=duplicate');
  }

  const sendInvite = form.get('send_invite') === '1';
  const { error } = await supabase.from('team_members').insert({ email, role: 'member' });
  if (error) {
    if (error.code === '23505') return Astro.redirect('/team/members?error=duplicate');
    console.error(error.message);
    return Astro.redirect('/team/members?error=invalid');
  }

  if (!sendInvite) {
    await logEvent(supabase, actor, { action: 'add', entityType: 'member', detail: email });
    return Astro.redirect('/team/members?notice=added');
  }
  const mail = await sendTeamInvite(email, Astro.request);
  await logEvent(supabase, actor, { action: 'add', entityType: 'member', detail: email });
  if (mail.error) return Astro.redirect('/team/members?notice=added-no-mail');
  return Astro.redirect('/team/members?notice=added-invited');
}

const { data } = await supabase.from('team_members').select('*').order('email');
const roleRank = { owner: 0, admin: 1, member: 2 } as const;
const members = ((data ?? []) as TeamMember[]).sort(
  (a, b) => roleRank[studioRoleOf(a.role, a.email)] - roleRank[studioRoleOf(b.role, b.email)] || a.email.localeCompare(b.email),
);
const counts = { owner: 0, admin: 0, member: 0 };
for (const member of members) counts[studioRoleOf(member.role, member.email)] += 1;
const canMail = mailConfigured();

function hasJoined(member: TeamMember) {
  return Boolean(member.last_seen_at || member.avatar_url?.trim() || member.display_name?.trim());
}
---

<Team title="Team">
  <div class="wrap team-page">
    <header class="team-intro">
      <p class="kicker">Team</p>
      <h1>People and roles</h1>
      <p class="lede">
        Only these emails can sign in with Google or GitHub. {SUPER_ADMIN_EMAIL} is always an owner.
        {isOwner ? 'As an owner you can change anyone’s role.' : 'Admins invite and remove members; owners change roles.'}
      </p>
    </header>
    <TeamFlash />

    <div class="team-two">
    <section class="team-card team-two-aside">
      <h2>Add a team email</h2>
      {
        !canMail && (
          <p class="muted">Invitation emails are not set up yet. You can still add the address.</p>
        )
      }
      <form class="form team-form" method="post">
        <input type="hidden" name="intent" value="add" />
        <p class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required placeholder="teammate@example.com" />
        </p>
        <label class="check-line">
          <input type="checkbox" name="send_invite" value="1" checked={canMail} />
          Send an invitation email
        </label>
        <button class="btn" type="submit">{canMail ? 'Whitelist and invite' : 'Whitelist'}</button>
      </form>
      <p class="muted roles-note">New people join as Members.{isOwner ? ' Change their role from the list.' : ''}</p>

      <div class="roles-explain">
        <h3>Roles</h3>
        <ul>
          {STUDIO_ROLES.map((role) => (
            <li>
              <span class:list={['role-badge', role]}>{STUDIO_ROLE_META[role].label}</span>
              <span>{STUDIO_ROLE_META[role].hint}</span>
              <em>{counts[role]}</em>
            </li>
          ))}
        </ul>
        <p class="muted">Inside a project, Members also get a project role: Lead, Manager, Collaborator, Developer, or QA.</p>
      </div>
    </section>

    <section class="team-card team-two-main">
      <h2>Current list</h2>
      <ul class="member-list">
        {
          members.map((member) => {
            const joined = hasJoined(member);
            const name = member.display_name?.trim() || member.email;
            const permanent = member.email === SUPER_ADMIN_EMAIL;
            const self = member.email === studio.email;
            const role = studioRoleOf(member.role, member.email);
            const canChangeRole = isOwner && !permanent && !self;
            const canRemove = !permanent && !self && (isOwner || role === 'member');
            return (
              <li class="member-hit">
                <div class="member-id">
                  <span class="presence-face">
                    {member.avatar_url?.trim() ? (
                      <img class="face" src={member.avatar_url} alt="" referrerpolicy="no-referrer" width="36" height="36" />
                    ) : (
                      <span class="face" aria-hidden="true">
                        {personInitial(name, member.email)}
                      </span>
                    )}
                    <i class:list={['presence-dot', availabilityOf(member).online && 'is-online', availabilityOf(member).away && 'is-away']} aria-hidden="true" />
                  </span>
                  <span>
                    <strong><a class="member-link" href={`/team/people/${member.email.split('@')[0].toLowerCase()}`}>{name}</a></strong>
                    <span>
                      {member.display_name?.trim() ? `${member.email} · ` : ''}
                      {member.job_title?.trim() ? `${member.job_title}` : ''}
                    </span>
                    <span class:list={['presence-label', availabilityOf(member).online && !availabilityOf(member).away && 'is-online', availabilityOf(member).away && 'is-away']}>
                      {availabilityOf(member).status?.emoji ? `${availabilityOf(member).status?.emoji} ` : ''}{availabilityOf(member).detail}
                    </span>
                  </span>
                </div>
                <div class="member-actions">
                  {canChangeRole ? (
                    <form method="post" class="role-form">
                      <input type="hidden" name="intent" value="set-role" />
                      <input type="hidden" name="email" value={member.email} />
                      <label class="sr-only" for={`role_${member.email}`}>Role for {name}</label>
                      <select id={`role_${member.email}`} name="role" class:list={['role-select', role]} data-role-select>
                        {STUDIO_ROLES.map((option) => (
                          <option value={option} selected={option === role}>{STUDIO_ROLE_META[option].label}</option>
                        ))}
                      </select>
                    </form>
                  ) : (
                    <span class:list={['role-badge', role]}>{STUDIO_ROLE_META[role].label}{self ? ' · you' : ''}</span>
                  )}
                  <span class:list={['status-pill', joined || permanent ? 'is-joined' : 'is-wait']}>
                    {permanent || joined ? 'Joined' : 'Invited'}
                  </span>
                  {canViewAs && !self && !permanent && (
                    <form method="post" action="/team/view-as" data-astro-reload>
                      <input type="hidden" name="intent" value="start" />
                      <input type="hidden" name="email" value={member.email} />
                      <input type="hidden" name="back" value="/team" />
                      <button class="btn-text view-as-btn" type="submit">View as</button>
                    </form>
                  )}
                  {!permanent && !joined && (
                    <form method="post">
                      <input type="hidden" name="intent" value="invite" />
                      <input type="hidden" name="email" value={member.email} />
                      <button class="btn-text" type="submit">Send invite</button>
                    </form>
                  )}
                  {canRemove && (
                    <form method="post" data-confirm="Remove this person from the team?">
                      <input type="hidden" name="intent" value="remove" />
                      <input type="hidden" name="email" value={member.email} />
                      <button class="btn-text" type="submit">Remove</button>
                    </form>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>
    </div>
  </div>
</Team>

<script>
  // Changing a role asks first, then saves.
  document.addEventListener('change', (event) => {
    const select = event.target;
    if (!(select instanceof HTMLSelectElement) || !select.matches('[data-role-select]')) return;
    const form = select.form;
    if (!form) return;
    const label = select.options[select.selectedIndex]?.text ?? select.value;
    form.setAttribute('data-confirm', `Change this person's role to ${label}?`);
    form.setAttribute('data-confirm-action', 'Change role');
    form.requestSubmit();
  });
</script>
