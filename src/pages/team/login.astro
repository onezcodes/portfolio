---
import Base from '../../layouts/Base.astro';

const errors: Record<string, string> = {
  'not-on-team':
    'This Google or GitHub account is not on the team list. Ask the super admin (onezcodes@gmail.com) to whitelist your email.',
  oauth: 'Sign-in did not complete. Try again.',
  'missing-code': 'Sign-in did not complete. Try again.',
  'unknown-provider': 'Choose Google or GitHub.',
  setup: 'Add PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY, then enable Google and GitHub in the Supabase Auth dashboard.',
};

const error = Astro.url.searchParams.get('error');
const errorText = error ? (errors[error] ?? 'Could not sign in.') : null;
---

<Base title="Team login" description="Private team workspace for Onez Codes." noindex>
  <header class="page-intro wrap">
    <p class="kicker">Team</p>
    <h1>Sign in to the studio ledger</h1>
  </header>

  <section class="section">
    <div class="wrap team-login">
      {
        errorText && (
          <p class="team-flash team-flash-err" role="alert">
            {errorText}
          </p>
        )
      }
      <p class="team-oauth">
        <a class="btn" href="/auth/signin?provider=google" data-astro-reload>Continue with Google</a>
        <a class="btn btn-ghost" href="/auth/signin?provider=github" data-astro-reload>Continue with GitHub</a>
      </p>
    </div>
  </section>
</Base>
