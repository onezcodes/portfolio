---
import Team from '../../layouts/Team.astro';
import TeamFlash from '../../components/TeamFlash.astro';
import { remainingLabel, type Contribution } from '../../lib/funding';
import IncomeExpenseChart from '../../components/IncomeExpenseChart.astro';
import { money, todayIso, totalsByCurrency, type LedgerEntry, type Project, type TeamMember } from '../../lib/ledger';
import { stagesByProject, type Milestone } from '../../lib/milestones';
import { capsFor } from '../../lib/access';
import { CREDENTIAL_STALE_DAYS, isStaleCredential, type CredentialRecord } from '../../lib/credentials';
import { eventHref, eventTitle, formatEventTime, type StudioEvent } from '../../lib/events';
import { logoHrefs } from '../../lib/projectHub';
import ProjectMark from '../../components/ProjectMark.astro';
import FacePile from '../../components/FacePile.astro';
import { facesByProject, personLabel } from '../../lib/profile';
import ProjectCalendar from '../../components/ProjectCalendar.astro';
import { parseMonth, studioEvents } from '../../lib/calendar';
import { attentionTasks, myOpenTasks, taskIsLate, taskStatusLabel, type ProjectTask } from '../../lib/tasks';
import { latestByProject, type ProjectCheckin } from '../../lib/checkins';

const supabase = Astro.locals.supabase;
const studio = Astro.locals.studio;
const ledgerSelect = 'kind, amount, currency, project_id, occurred_on, category';

const [{ data: projects }, { data: entries }, { data: contribs }, { data: milestoneRows }, { data: taskRows }, { data: checkinRows }, { data: eventRows }, creds, { data: crewRows }, { data: memberRows }] =
  await Promise.all([
    supabase.from('projects').select('id, name, client, status, logo_url, started_on').order('updated_at', { ascending: false }),
    studio?.canLedger
      ? supabase.from('ledger_entries').select(ledgerSelect).order('occurred_on', { ascending: false })
      : Promise.resolve({ data: [] }),
    studio?.canLedger
      ? supabase.from('project_contributions').select('project_id, amount, currency')
      : Promise.resolve({ data: [] }),
    supabase.from('project_milestones').select('project_id, title, status, estimated_on, sort_order'),
    supabase.from('project_tasks').select('id, project_id, title, status, assignee_email, due_on, milestone_id, notes, sort_order, created_at, updated_at'),
    supabase.from('project_checkins').select('id, project_id, author_email, body, created_at').order('created_at', { ascending: false }).limit(40),
    supabase.from('studio_events').select('id, action, entity_type, entity_id, project_id, actor_email, detail, created_at').order('created_at', { ascending: false }).limit(8),
    studio?.canVault
      ? supabase.from('studio_credentials').select('id, title, updated_at')
      : Promise.resolve({ data: [] }),
    supabase.from('project_members').select('project_id, email'),
    supabase.from('team_members').select('email, display_name, avatar_url').order('email'),
  ]);

const projectRows = (projects ?? []) as Project[];
const allEntries = (entries ?? []) as LedgerEntry[];
const recent = allEntries.slice(0, 12);
const totals = totalsByCurrency(allEntries);
const expenseRows = allEntries;
const contribRows = contribs ?? [];
const stages = stagesByProject((milestoneRows ?? []) as Milestone[]);

const byProject = new Map(projectRows.map((project) => [project.id, project.name]));
const today = todayIso();
const overdue = ((milestoneRows ?? []) as Milestone[]).filter(
  (row) => row.estimated_on && row.estimated_on < today && row.status !== 'done',
);
const currentWork = ((milestoneRows ?? []) as Milestone[]).filter((row) => row.status === 'current');
const activity = (eventRows ?? []) as StudioEvent[];
const staleVault = ((creds.data ?? []) as Pick<CredentialRecord, 'id' | 'title' | 'updated_at'>[]).filter((item) =>
  isStaleCredential(item.updated_at),
);
const marks = await logoHrefs(supabase, projectRows);
const crewFaces = facesByProject(
  (crewRows ?? []) as { project_id: string; email: string }[],
  (memberRows ?? []) as Pick<TeamMember, 'email' | 'display_name' | 'avatar_url'>[],
);
const visibleProjects = studio
  ? projectRows.filter((project) => capsFor(studio, project.id).assigned)
  : [];
const allTasks = (taskRows ?? []) as ProjectTask[];
const people = (memberRows ?? []) as Pick<TeamMember, 'email' | 'display_name' | 'avatar_url'>[];
const mine = studio ? myOpenTasks(allTasks, studio.email) : [];
const flagged = attentionTasks(allTasks).filter((row) => !mine.some((item) => item.id === row.id));
const notes = [...latestByProject((checkinRows ?? []) as ProjectCheckin).values()]
  .filter((row) => visibleProjects.some((project) => project.id === row.project_id))
  .slice(0, 6);
const calCursor = parseMonth(Astro.url.searchParams.get('month'), new Date());
const calendarEvents = studio
  ? studioEvents(
      visibleProjects,
      (milestoneRows ?? []) as Milestone[],
      (contribRows ?? []) as Pick<Contribution, 'amount' | 'currency' | 'occurred_on' | 'member_email' | 'notes' | 'project_id'>[],
      allEntries,
      {
        canSchedule: (projectId) => capsFor(studio, projectId).canSchedule,
        canFinance: (projectId) => capsFor(studio, projectId).canFinance,
        includeOverhead: studio.canLedger,
      },
      allTasks,
    )
  : [];
const calendarHasMoney = calendarEvents.some(
  (event) => event.kind === 'contribution' || event.kind === 'income' || event.kind === 'expense',
);
---

<Team title="Overview">
  <div class="wrap team-page">
    <header class="team-intro">
      <p class="kicker">Overview</p>
      <h1>Work</h1>
      <p class="lede">
        {studio?.canLedger
          ? 'Owned tasks, jobs, and studio books. Nothing here is published to the public site.'
          : 'Projects you can access. Your tasks and the plan — funding stays with leads and collaborators.'}
      </p>
      <form class="search-form" method="get" action="/team/search">
        <label class="sr-only" for="q">Search the team app</label>
        <input id="q" name="q" placeholder="Search projects, tasks, or credentials" />
        <button class="btn" type="submit">Search</button>
      </form>
    </header>
    <nav class="quick-actions" aria-label="Quick actions">
      <a class="btn" href="/team/projects?new=1">New project</a>
      {studio?.canLedger && <a class="btn btn-ghost" href="/team/ledger">Add ledger entry</a>}
      {studio?.canVault && <a class="btn btn-ghost" href="/team/credentials">Shared credentials</a>}
      {studio?.superAdmin && <a class="btn btn-ghost" href="/team/members">Whitelist email</a>}
    </nav>
    <TeamFlash />

    {
      mine.length > 0 && (
        <section class="team-card">
          <div class="section-head tight">
            <h2>My work</h2>
            <p class="muted">{mine.length} open {mine.length === 1 ? 'task' : 'tasks'} assigned to you</p>
          </div>
          <ul class="team-list">
            {mine.slice(0, 8).map((row) => (
              <li>
                <a href={`/team/projects/${row.project_id}?tab=schedule`}>
                  <strong>{row.title}</strong>
                  <span>
                    {byProject.get(row.project_id) || 'Project'} · {taskIsLate(row, today) ? 'Late' : taskStatusLabel(row.status)}
                    {row.due_on ? ` · due ${row.due_on}` : ''}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      notes.length > 0 && (
        <section class="team-card">
          <div class="section-head tight">
            <h2>Now</h2>
            <p class="muted">Latest check-in on each job</p>
          </div>
          <ul class="team-list">
            {notes.map((row) => (
              <li>
                <a href={`/team/projects/${row.project_id}?tab=schedule#checkin`}>
                  <strong>{byProject.get(row.project_id) || 'Project'}</strong>
                  <span>
                    {row.body} · {personLabel(row.author_email, people)} · {formatEventTime(row.created_at)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="team-split overview-lead">
      <div class="team-card">
      <div class="section-head tight">
        <h2>Projects</h2>
        <a href="/team/projects">All projects</a>
      </div>
      {
        projectRows.length === 0 ? (
          <p class="muted">No projects yet.</p>
        ) : (
          <ul class="team-list">
            {visibleProjects
              .filter((project) => project.status === 'active')
              .concat(visibleProjects.filter((project) => project.status !== 'active'))
              .slice(0, 8)
              .map((project) => (
              <li>
                <a class="project-hit" href={`/team/projects/${project.id}`}>
                  <ProjectMark name={project.name} src={marks.get(project.logo_url)} />
                  <span>
                    <strong>{project.name}</strong>
                    <span>
                      {project.client || 'No client'} · {stages.get(project.id) || project.status}
                      {studio && capsFor(studio, project.id).canFinance
                        ? ` · ${remainingLabel(project.id, contribRows, expenseRows)}`
                        : ''}
                    </span>
                  </span>
                  <FacePile people={crewFaces.get(project.id) ?? []} label="Assigned" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
      </div>
      {
        (overdue.length > 0 || currentWork.length > 0 || staleVault.length > 0 || flagged.length > 0) && (
        <section class="team-card">
          <h2>Needs attention</h2>
          {flagged.length > 0 && (
            <>
              <p class="muted">Blocked or late work</p>
              <ul class="team-list">
                {flagged.slice(0, 6).map((row) => (
                  <li>
                    <a href={`/team/projects/${row.project_id}?tab=schedule`}>
                      <strong>{row.title}</strong>
                      <span>
                        {byProject.get(row.project_id) || 'Project'} · {taskIsLate(row, today) ? 'Late' : taskStatusLabel(row.status)}
                        {row.assignee_email ? ` · ${personLabel(row.assignee_email, people)}` : ''}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
          {overdue.length > 0 && (
            <>
              <p class="muted">Stages past their estimate</p>
              <ul class="team-list">
                {overdue.slice(0, 6).map((row) => (
                  <li>
                    <a href={`/team/projects/${row.project_id}?tab=schedule`}>
                      <strong>{row.title}</strong>
                      <span>
                        {byProject.get(row.project_id) || 'Project'} · est. {row.estimated_on}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
          {currentWork.length > 0 && (
            <>
              <p class="muted">Current stage</p>
              <ul class="team-list">
                {currentWork.slice(0, 6).map((row) => (
                  <li>
                    <a href={`/team/projects/${row.project_id}?tab=schedule`}>
                      <strong>{row.title}</strong>
                      <span>{byProject.get(row.project_id) || 'Project'}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
          {staleVault.length > 0 && (
            <>
              <p class="muted">Credentials not updated in {CREDENTIAL_STALE_DAYS}+ days</p>
              <ul class="team-list">
                {staleVault.slice(0, 6).map((item) => (
                  <li>
                    <a href={`/team/credentials/${item.id}`}>
                      <strong>{item.title}</strong>
                      <span>Review password and keys</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>
      )
    }
    </section>

    {
      visibleProjects.length > 0 && (
        <ProjectCalendar
          cursor={calCursor}
          today={today}
          events={calendarEvents}
          monthHref={(month) => `/team?month=${month}`}
          showMoney={calendarHasMoney}
          lede={
            calendarHasMoney
              ? 'Stages, tasks, and money dates for projects you can access.'
              : 'Stages, tasks, and start dates for projects you can access.'
          }
        />
      )
    }

    {
      studio?.canLedger && (
        <>
          <section class="team-totals" aria-label="Totals">
            {
              totals.length === 0 ? (
                <p class="muted">No ledger entries yet.</p>
              ) : (
                totals.map((row) => (
                  <article class="team-stat">
                    <p class="kicker">{row.currency}</p>
                    <dl>
                      <div>
                        <dt>Income</dt>
                        <dd>{money(row.income, row.currency)}</dd>
                      </div>
                      <div>
                        <dt>Expense</dt>
                        <dd>{money(row.expense, row.currency)}</dd>
                      </div>
                      <div>
                        <dt>Profit</dt>
                        <dd>{money(row.profit, row.currency)}</dd>
                      </div>
                    </dl>
                  </article>
                ))
              )
            }
          </section>
          <IncomeExpenseChart entries={allEntries} />
        </>
      )
    }

    {
      studio?.canLedger && (
      <section>
        <div class="section-head tight">
          <h2>Recent entries</h2>
          <a href="/team/ledger">Full ledger</a>
        </div>
        {
          recent.length === 0 ? (
            <p class="muted">No income or expenses yet.</p>
          ) : (
            <ul class="team-list">
              {recent.map((entry) => (
                <li>
                  <span>
                    <strong>
                      {entry.kind === 'income' ? '+' : '−'}
                      {money(entry.amount, entry.currency)}
                    </strong>
                    <span>
                      {entry.occurred_on} · {entry.project_id ? byProject.get(entry.project_id) || 'Project' : 'Overhead'}
                      {entry.category ? ` · ${entry.category}` : ''}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </section>
      )
    }

    {
      activity.length > 0 && (
        <section>
          <div class="section-head tight">
            <h2>Activity</h2>
            <a href="/team/activity">All activity</a>
          </div>
          <ul class="team-list">
            {activity.map((row) => (
              <li>
                <a href={eventHref(row)}>
                  <strong>{eventTitle(row)}</strong>
                  <span>
                    {formatEventTime(row.created_at)} · {row.actor_email}
                    {row.detail ? ` · ${row.detail}` : ''}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Team>
