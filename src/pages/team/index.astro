---
import Team from '../../layouts/Team.astro';
import TeamFlash from '../../components/TeamFlash.astro';
import { fundingByCurrency, remainingLabel, type Contribution } from '../../lib/funding';
import { projectHealth } from '../../lib/health';
import { byPresence, presenceOf } from '../../lib/presence';
import { personInitial } from '../../lib/profile';
import IncomeExpenseChart from '../../components/IncomeExpenseChart.astro';
import { money, todayIso, totalsByCurrency, type LedgerEntry, type Project, type TeamMember } from '../../lib/ledger';
import { stagesByProject, type Milestone } from '../../lib/milestones';
import { capsFor } from '../../lib/access';
import { CREDENTIAL_STALE_DAYS, isStaleCredential, type CredentialRecord } from '../../lib/credentials';
import { eventHref, eventTitle, formatEventTime, type StudioEvent } from '../../lib/events';
import { logoHrefs } from '../../lib/projectHub';
import ProjectMark from '../../components/ProjectMark.astro';
import FacePile from '../../components/FacePile.astro';
import { facesByProject, personLabel } from '../../lib/profile';
import ProjectCalendar from '../../components/ProjectCalendar.astro';
import { parseMonth, studioEvents } from '../../lib/calendar';
import { attentionTasks, myOpenTasks, taskIsLate, taskStatusLabel, type ProjectTask } from '../../lib/tasks';
import { latestByProject, type ProjectCheckin } from '../../lib/checkins';

const supabase = Astro.locals.supabase;
const studio = Astro.locals.studio;
const ledgerSelect = 'kind, amount, currency, project_id, occurred_on, category, notes';

const [[{ data: projects }, marks], { data: entries }, { data: contribs }, { data: milestoneRows }, { data: taskRows }, { data: checkinRows }, { data: eventRows }, creds, { data: crewRows }, { data: memberRows }] =
  await Promise.all([
    // Sign logo URLs as soon as projects arrive, overlapping the other queries instead of waiting on all of them.
    supabase
      .from('projects')
      .select('id, name, client, status, logo_url, started_on')
      .order('updated_at', { ascending: false })
      .then(async (res) => [res, await logoHrefs(supabase, (res.data ?? []) as Project[])] as const),
    studio?.canLedger
      ? supabase.from('ledger_entries').select(ledgerSelect).order('occurred_on', { ascending: false })
      : Promise.resolve({ data: [] }),
    studio?.canLedger
      ? supabase.from('project_contributions').select('project_id, amount, currency, occurred_on, member_email, notes')
      : Promise.resolve({ data: [] }),
    supabase.from('project_milestones').select('project_id, title, status, estimated_on, sort_order'),
    // Done tasks never appear on the overview (calendar, My work, Needs attention all skip them).
    supabase.from('project_tasks').select('id, project_id, title, status, assignee_email, due_on, sort_order').neq('status', 'done'),
    supabase.from('project_checkins').select('id, project_id, author_email, body, created_at').order('created_at', { ascending: false }).limit(40),
    supabase.from('studio_events').select('id, action, entity_type, entity_id, project_id, actor_email, detail, created_at').order('created_at', { ascending: false }).limit(8),
    studio?.canVault
      ? supabase.from('studio_credentials').select('id, title, updated_at')
      : Promise.resolve({ data: [] }),
    supabase.from('project_members').select('project_id, email'),
    supabase.from('team_members').select('email, display_name, avatar_url, last_seen_at').order('email'),
  ]);

const projectRows = (projects ?? []) as Project[];
const allEntries = (entries ?? []) as LedgerEntry[];
const recent = allEntries.slice(0, 12);
const totals = totalsByCurrency(allEntries);
const expenseRows = allEntries;
const contribRows = contribs ?? [];
const stages = stagesByProject((milestoneRows ?? []) as Milestone[]);

const byProject = new Map(projectRows.map((project) => [project.id, project.name]));
const today = todayIso();
const overdue = ((milestoneRows ?? []) as Milestone[]).filter(
  (row) => row.estimated_on && row.estimated_on < today && row.status !== 'done',
);
const activity = (eventRows ?? []) as StudioEvent[];
const staleVault = ((creds.data ?? []) as Pick<CredentialRecord, 'id' | 'title' | 'updated_at'>[]).filter((item) =>
  isStaleCredential(item.updated_at),
);
const crewFaces = facesByProject(
  (crewRows ?? []) as { project_id: string; email: string }[],
  (memberRows ?? []) as Pick<TeamMember, 'email' | 'display_name' | 'avatar_url'>[],
);
const visibleProjects = studio
  ? projectRows.filter((project) => capsFor(studio, project.id).assigned)
  : [];
const allTasks = (taskRows ?? []) as ProjectTask[];
const people = (memberRows ?? []) as Pick<TeamMember, 'email' | 'display_name' | 'avatar_url'>[];
const mine = studio ? myOpenTasks(allTasks, studio.email) : [];
const flagged = attentionTasks(allTasks).filter((row) => !mine.some((item) => item.id === row.id));
const notes = [...latestByProject((checkinRows ?? []) as ProjectCheckin).values()]
  .filter((row) => visibleProjects.some((project) => project.id === row.project_id))
  .slice(0, 6);
const calCursor = parseMonth(Astro.url.searchParams.get('month'), new Date());
const calendarEvents = studio
  ? studioEvents(
      visibleProjects,
      (milestoneRows ?? []) as Milestone[],
      (contribRows ?? []) as Pick<Contribution, 'amount' | 'currency' | 'occurred_on' | 'member_email' | 'notes' | 'project_id'>[],
      allEntries,
      {
        canSchedule: (projectId) => capsFor(studio, projectId).canSchedule,
        canFinance: (projectId) => capsFor(studio, projectId).canFinance,
        includeOverhead: studio.canLedger,
      },
      allTasks,
    )
  : [];
const calendarHasMoney = calendarEvents.some(
  (event) => event.kind === 'contribution' || event.kind === 'income' || event.kind === 'expense',
);

const activeCount = visibleProjects.filter((project) => project.status === 'active').length;
const attentionCount = flagged.length + overdue.length + staleVault.length;
const monthKeyNow = today.slice(0, 7);
const monthTotals = totalsByCurrency(allEntries.filter((entry) => entry.occurred_on?.startsWith(monthKeyNow)));
const monthLead = monthTotals[0] ?? null;
const firstName = (studio?.displayName || '').trim().split(/\s+/)[0] || 'there';
const todayLabel = new Date(`${today}T12:00:00`).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
const orderedProjects = visibleProjects
  .filter((project) => project.status === 'active')
  .concat(visibleProjects.filter((project) => project.status !== 'active'));
const ATTENTION_CAP = 4;
const nowMs = Date.now();
const teamByPresence = byPresence((memberRows ?? []) as { email: string; display_name: string; avatar_url: string; last_seen_at: string | null }[], nowMs);
const onlineNow = teamByPresence.filter((m) => m.email !== studio?.email && presenceOf(m.last_seen_at, nowMs).online);
const recentlyActive = teamByPresence
  .filter((m) => m.email !== studio?.email && !presenceOf(m.last_seen_at, nowMs).online && m.last_seen_at)
  .slice(0, 3);
const latestCheckinAt = new Map<string, string>();
for (const row of (checkinRows ?? []) as ProjectCheckin[]) {
  if (!latestCheckinAt.has(row.project_id)) latestCheckinAt.set(row.project_id, row.created_at);
}
function healthOf(project: Project) {
  const finance = studio ? capsFor(studio, project.id).canFinance : false;
  return projectHealth({
    status: project.status,
    today,
    stages: ((milestoneRows ?? []) as Milestone[]).filter((m) => m.project_id === project.id),
    tasks: allTasks.filter((t) => t.project_id === project.id),
    lastCheckin: latestCheckinAt.get(project.id) ?? null,
    funding: finance
      ? fundingByCurrency(
          (contribRows as { project_id: string; amount: number; currency: string }[]).filter((row) => row.project_id === project.id),
          allEntries.filter((row) => row.project_id === project.id && row.kind === 'expense'),
        )
      : null,
  });
}
const offTrack = orderedProjects.filter((project) => healthOf(project).level === 'red').length;
---

<Team title="Overview">
  <div class="wrap team-page ov">
    <header class="ov-hero">
      <div class="ov-hello">
        <p class="ov-date">{todayLabel}</p>
        <h1>Welcome back, {firstName}</h1>
        <p class="lede">
          {studio?.canLedger
            ? 'Your tasks, jobs, and studio books in one place. Nothing here is public.'
            : 'Projects you can access, your tasks, and the plan.'}
        </p>
      </div>
      <form class="ov-search" method="get" action="/team/search" role="search">
        <label class="sr-only" for="q">Search the team app</label>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input id="q" name="q" placeholder="Search projects, tasks, credentials…" autocomplete="off" />
        <button class="btn" type="submit">Search</button>
      </form>
      <nav class="quick-actions" aria-label="Quick actions">
        <a class="btn" href="/team/projects?new=1"><span aria-hidden="true">+</span> New project</a>
        {studio?.canLedger && <a class="btn btn-ghost" href="/team/ledger">Add ledger entry</a>}
        {studio?.canVault && <a class="btn btn-ghost" href="/team/credentials">Credentials</a>}
        {studio?.superAdmin && <a class="btn btn-ghost" href="/team/members">Whitelist email</a>}
      </nav>
    </header>

    <section class="ov-stats" aria-label="At a glance">
      <a class="ov-stat" href="#my-work">
        <span class="ov-stat-label">My open tasks</span>
        <strong>{mine.length}</strong>
        <span class="ov-stat-note">{mine.filter((row) => taskIsLate(row, today)).length} late</span>
      </a>
      <a class="ov-stat" href="/team/projects">
        <span class="ov-stat-label">Active projects</span>
        <strong>{activeCount}</strong>
        <span class="ov-stat-note">{offTrack > 0 ? `${offTrack} off track` : `of ${visibleProjects.length} you can access`}</span>
      </a>
      <a class:list={['ov-stat', attentionCount > 0 && 'is-alert']} href="#attention">
        <span class="ov-stat-label">Needs attention</span>
        <strong>{attentionCount}</strong>
        <span class="ov-stat-note">{attentionCount === 0 ? 'All clear' : 'Blocked, late, or stale'}</span>
      </a>
      {
        studio?.canLedger && (
          <a class="ov-stat is-money" href="/team/ledger">
            <span class="ov-stat-label">Net this month</span>
            <strong>{monthLead ? money(monthLead.profit, monthLead.currency) : '—'}</strong>
            <span class="ov-stat-note">
              {monthLead ? `${money(monthLead.income, monthLead.currency)} in · ${money(monthLead.expense, monthLead.currency)} out` : 'No entries yet'}
            </span>
          </a>
        )
      }
    </section>

    <TeamFlash />

    <div class="ov-grid">
      <div class="ov-main">
        {
          mine.length > 0 && (
            <section class="team-card" id="my-work">
              <div class="ov-card-head">
                <h2>My work</h2>
                <span class="ov-count">{mine.length}</span>
              </div>
              <ul class="team-list">
                {mine.slice(0, 8).map((row) => (
                  <li>
                    <a class="ov-task" href={`/team/projects/${row.project_id}?tab=tasks&task=${row.id}`}>
                      <i class:list={['ov-dot', taskIsLate(row, today) ? 'late' : row.status]} aria-hidden="true" />
                      <span>
                        <strong>{row.title}</strong>
                        <span>
                          {byProject.get(row.project_id) || 'Project'} · {taskIsLate(row, today) ? 'Late' : taskStatusLabel(row.status)}
                          {row.due_on ? ` · due ${row.due_on}` : ''}
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="team-card">
          <div class="ov-card-head">
            <h2>Projects</h2>
            <a href="/team/projects">All projects →</a>
          </div>
          {
            orderedProjects.length === 0 ? (
              <p class="muted">No projects yet.</p>
            ) : (
              <ul class="team-list">
                {orderedProjects.slice(0, 8).map((project) => (
                  <li>
                    <a class="project-hit" href={`/team/projects/${project.id}`}>
                      <ProjectMark name={project.name} src={marks.get(project.logo_url)} />
                      <span>
                        <strong>
                          {project.name}
                          {(() => {
                            const health = healthOf(project);
                            return health.level === 'idle' ? (
                              <em class:list={['ov-status', project.status]}>{project.status}</em>
                            ) : (
                              <span class:list={['health-badge', 'sm', health.level]} title={health.reasons.join(' · ') || 'Everything on schedule'}>
                                <i aria-hidden="true" />
                                {health.label}
                              </span>
                            );
                          })()}
                        </strong>
                        <span>
                          {project.client || 'No client'} · {stages.get(project.id) || project.status}
                          {studio && capsFor(studio, project.id).canFinance
                            ? ` · ${remainingLabel(project.id, contribRows, expenseRows)}`
                            : ''}
                        </span>
                      </span>
                      <FacePile people={crewFaces.get(project.id) ?? []} label="Assigned" />
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </section>
        {
          visibleProjects.length > 0 && (
            <ProjectCalendar
              cursor={calCursor}
              today={today}
              events={calendarEvents}
              monthHref={(month) => `/team?month=${month}`}
              agendaCollapsed
              showMoney={calendarHasMoney}
              lede={
                calendarHasMoney
                  ? 'Stages, tasks, and money dates for projects you can access.'
                  : 'Stages, tasks, and start dates for projects you can access.'
              }
            />
          )
        }
      </div>

      <aside class="ov-side">
        <section class="team-card ov-online">
          <div class="ov-card-head">
            <h2>Online now</h2>
            <span class:list={['presence-count', onlineNow.length > 0 && 'is-online']}><i aria-hidden="true" />{onlineNow.length}</span>
          </div>
          {onlineNow.length > 0 ? (
            <ul class="ov-online-faces">
              {onlineNow.map((member) => {
                const label = member.display_name?.trim() || member.email.split('@')[0];
                return (
                  <li title={`${label} · online`}>
                    <span class="presence-face">
                      {member.avatar_url?.trim() ? (
                        <img class="face" src={member.avatar_url} alt="" referrerpolicy="no-referrer" width="34" height="34" />
                      ) : (
                        <span class="face" aria-hidden="true">{personInitial(label, member.email)}</span>
                      )}
                      <i class="presence-dot is-online" aria-hidden="true" />
                    </span>
                    <span>{label.split(' ')[0]}</span>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="muted">Just you right now.</p>
          )}
          {recentlyActive.length > 0 && (
            <p class="ov-recent">
              {recentlyActive.map((member) => (
                <span>{member.display_name?.trim() || member.email.split('@')[0]} · {presenceOf(member.last_seen_at, nowMs).label.replace(/^Active /, '')}</span>
              ))}
            </p>
          )}
        </section>
        <section class="team-card" id="attention">
          <div class="ov-card-head">
            <h2>Needs attention</h2>
            {attentionCount > 0 && <span class="ov-count is-alert">{attentionCount}</span>}
          </div>
          {attentionCount === 0 ? (
            <p class="ov-empty">Nothing blocked, late, or stale. Nice.</p>
          ) : (
            <div class="ov-attention">
              {flagged.length > 0 && (
                <div>
                  <p class="ov-group">Blocked or late work</p>
                  <ul class="team-list">
                    {flagged.slice(0, ATTENTION_CAP).map((row) => (
                      <li>
                        <a class="ov-task" href={`/team/projects/${row.project_id}?tab=tasks&task=${row.id}`}>
                          <i class:list={['ov-dot', taskIsLate(row, today) ? 'late' : row.status]} aria-hidden="true" />
                          <span>
                            <strong>{row.title}</strong>
                            <span>
                              {byProject.get(row.project_id) || 'Project'} · {taskIsLate(row, today) ? 'Late' : taskStatusLabel(row.status)}
                              {row.assignee_email ? ` · ${personLabel(row.assignee_email, people)}` : ''}
                            </span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  {flagged.length > ATTENTION_CAP && <p class="ov-more">+{flagged.length - ATTENTION_CAP} more</p>}
                </div>
              )}
              {overdue.length > 0 && (
                <div>
                  <p class="ov-group">Stages past their estimate</p>
                  <ul class="team-list">
                    {overdue.slice(0, ATTENTION_CAP).map((row) => (
                      <li>
                        <a class="ov-task" href={`/team/projects/${row.project_id}?tab=schedule`}>
                          <i class="ov-dot late" aria-hidden="true" />
                          <span>
                            <strong>{row.title}</strong>
                            <span>
                              {byProject.get(row.project_id) || 'Project'} · est. {row.estimated_on}
                            </span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  {overdue.length > ATTENTION_CAP && <p class="ov-more">+{overdue.length - ATTENTION_CAP} more</p>}
                </div>
              )}
              {staleVault.length > 0 && (
                <div>
                  <p class="ov-group">Credentials not updated in {CREDENTIAL_STALE_DAYS}+ days</p>
                  <ul class="team-list">
                    {staleVault.slice(0, ATTENTION_CAP).map((item) => (
                      <li>
                        <a class="ov-task" href={`/team/credentials/${item.id}`}>
                          <i class="ov-dot stale" aria-hidden="true" />
                          <span>
                            <strong>{item.title}</strong>
                            <span>Review password and keys</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  {staleVault.length > ATTENTION_CAP && <p class="ov-more">+{staleVault.length - ATTENTION_CAP} more</p>}
                </div>
              )}
            </div>
          )}
        </section>

        {
          notes.length > 0 && (
            <section class="team-card">
              <div class="ov-card-head">
                <h2>Now</h2>
                <span class="muted">Latest check-ins</span>
              </div>
              <ul class="ov-notes">
                {notes.map((row) => (
                  <li>
                    <a href={`/team/projects/${row.project_id}?tab=schedule#checkin`}>
                      <strong>{byProject.get(row.project_id) || 'Project'}</strong>
                      <p>{row.body}</p>
                      <span>
                        {personLabel(row.author_email, people)} · {formatEventTime(row.created_at)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          activity.length > 0 && (
            <section class="team-card">
              <div class="ov-card-head">
                <h2>Activity</h2>
                <a href="/team/activity">All →</a>
              </div>
              <ol class="ov-feed">
                {activity.map((row) => (
                  <li>
                    <a href={eventHref(row)}>
                      <strong>{eventTitle(row)}</strong>
                      <span>
                        {formatEventTime(row.created_at)} · {personLabel(row.actor_email, people)}
                        {row.detail ? ` · ${row.detail}` : ''}
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
      </aside>
    </div>

    {
      studio?.canLedger && (
        <section class="ov-books" aria-label="Studio books">
          <div class="ov-books-head">
            <h2>Studio books</h2>
            <a href="/team/ledger">Full ledger →</a>
          </div>
          {totals.length === 0 ? (
            <p class="muted">No ledger entries yet.</p>
          ) : (
            <div class="team-totals">
              {totals.map((row) => (
                <article class="team-stat">
                  <p class="kicker">{row.currency} · all time</p>
                  <dl>
                    <div>
                      <dt>Income</dt>
                      <dd>{money(row.income, row.currency)}</dd>
                    </div>
                    <div>
                      <dt>Expense</dt>
                      <dd>{money(row.expense, row.currency)}</dd>
                    </div>
                    <div class="is-total">
                      <dt>Profit</dt>
                      <dd>{money(row.profit, row.currency)}</dd>
                    </div>
                  </dl>
                </article>
              ))}
            </div>
          )}
          <div class="ov-books-grid">
            <IncomeExpenseChart entries={allEntries} />
            <section class="team-card">
              <div class="ov-card-head">
                <h2>Recent entries</h2>
                <a href="/team/ledger">Full ledger →</a>
              </div>
              {recent.length === 0 ? (
                <p class="muted">No income or expenses yet.</p>
              ) : (
                <ul class="ov-entries">
                  {recent.slice(0, 6).map((entry) => (
                    <li>
                      <span class="ov-entry-meta">
                        <strong>{entry.category || (entry.kind === 'income' ? 'Income' : 'Expense')}</strong>
                        <span>
                          {entry.occurred_on} · {entry.project_id ? byProject.get(entry.project_id) || 'Project' : 'Overhead'}
                        </span>
                      </span>
                      <strong class:list={['ov-amount', entry.kind]}>
                        {entry.kind === 'income' ? '+' : '−'}
                        {money(entry.amount, entry.currency)}
                      </strong>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </div>
        </section>
      )
    }
  </div>
</Team>
