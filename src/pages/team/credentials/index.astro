---
import Team from '../../../layouts/Team.astro';
import TeamFlash from '../../../components/TeamFlash.astro';
import { CREDENTIAL_STALE_DAYS, credentialPayload, isStaleCredential, vaultReady, type CredentialRecord } from '../../../lib/credentials';
import { logEvent } from '../../../lib/events';
import { notifyVaultGrants } from '../../../lib/mail';
import { emailOf, isSuperAdmin, SUPER_ADMIN_EMAIL } from '../../../lib/supabase';
import type { TeamMember } from '../../../lib/ledger';

const studio = Astro.locals.studio;
const supabase = Astro.locals.supabase;
const admin = isSuperAdmin(Astro.locals.user);

if (!studio?.canVault) {
  return Astro.redirect('/team?error=forbidden');
}

if (Astro.request.method === 'POST') {
  if (!admin) return Astro.redirect('/team/credentials?error=forbidden');
  if (!vaultReady()) return Astro.redirect('/team/credentials?new=1&error=vault-setup');

  const form = await Astro.request.formData();
  let payload: ReturnType<typeof credentialPayload>;
  try {
    payload = credentialPayload(form);
  } catch {
    return Astro.redirect('/team/credentials?new=1&error=vault-setup');
  }
  if (!payload) return Astro.redirect('/team/credentials?new=1&error=invalid');

  const { data, error } = await supabase
    .from('studio_credentials')
    .insert({ ...payload, created_by: Astro.locals.user?.id ?? null })
    .select('id')
    .single();
  if (error || !data) {
    console.error(error?.message);
    return Astro.redirect('/team/credentials?new=1&error=invalid');
  }

  const actor = studio?.email || emailOf(Astro.locals.user);
  await logEvent(supabase, actor, {
    action: 'create',
    entityType: 'credential',
    entityId: data.id,
    detail: payload.title,
  });

  const viewers = form
    .getAll('viewer')
    .map((value) => String(value).trim().toLowerCase())
    .filter((email) => email && email !== SUPER_ADMIN_EMAIL);
  if (viewers.length > 0) {
    const { error: grantError } = await supabase.from('studio_credential_access').insert(
      viewers.map((email) => ({ credential_id: data.id, email })),
    );
    if (grantError) console.error(grantError.message);
    else await notifyVaultGrants(viewers, payload.title, Astro.request);
  }

  return Astro.redirect(`/team/credentials/${data.id}?notice=created`);
}

const [{ data: rows }, { data: memberRows }] = await Promise.all([
  supabase.from('studio_credentials').select('id, title, website, updated_at').order('title'),
  admin ? supabase.from('team_members').select('*').order('email') : Promise.resolve({ data: [] }),
]);
const credentials = (rows ?? []) as Pick<CredentialRecord, 'id' | 'title' | 'website' | 'updated_at'>[];
const members = ((memberRows ?? []) as TeamMember[]).filter((member) => member.email !== SUPER_ADMIN_EMAIL);
const creating =
  admin &&
  (Astro.url.searchParams.has('new') ||
    Astro.url.searchParams.get('error') === 'invalid' ||
    Astro.url.searchParams.get('error') === 'vault-setup');
---

<Team title="Credentials">
  <div class="wrap team-page">
    <header class="team-intro">
      <p class="kicker">Studio</p>
      <h1>Shared credentials</h1>
      <p class="lede">
        Passwords, API keys, and tokens for studio services — not tied to one project.
        {admin ? ' You choose who can open each item.' : ' You only see what you have been given access to.'}
      </p>
    </header>
    {
      admin && (
        <nav class="quick-actions" aria-label="Quick actions">
          <a class="btn" href="/team/credentials?new=1">New credentials</a>
        </nav>
      )
    }
    <TeamFlash />

    {
      creating && (
        <section class="team-card">
          <h2>New credentials</h2>
          {
            !vaultReady() && (
              <p class="muted">Set CREDENTIALS_SECRET before saving secrets.</p>
            )
          }
          <form class="form team-form" method="post">
            <p class="field">
              <label for="title">Name</label>
              <input id="title" name="title" required placeholder="Supabase production" />
            </p>
            <p class="field">
              <label for="website">Website</label>
              <input id="website" name="website" placeholder="https://app.example.com" />
            </p>
            <div class="team-form-row">
              <p class="field">
                <label for="username">Username</label>
                <input id="username" name="username" autocomplete="off" />
              </p>
              <p class="field">
                <label for="login_email">Login email</label>
                <input id="login_email" name="login_email" type="email" autocomplete="off" />
              </p>
            </div>
            <p class="field">
              <label for="password">Password</label>
              <input id="password" name="password" type="password" autocomplete="new-password" />
            </p>
            <p class="field">
              <label for="api_key">API key</label>
              <input id="api_key" name="api_key" autocomplete="off" />
            </p>
            <p class="field">
              <label for="api_token">API token</label>
              <input id="api_token" name="api_token" autocomplete="off" />
            </p>
            <p class="field">
              <label for="notes">Notes</label>
              <textarea id="notes" name="notes" rows="3" placeholder="Where this is used, extra fields…"></textarea>
            </p>
            {
              members.length > 0 && (
                <fieldset class="role-picks">
                  <legend class="muted">Who can view</legend>
                  {members.map((member) => (
                    <label>
                      <input type="checkbox" name="viewer" value={member.email} />
                      <span>{member.email}</span>
                    </label>
                  ))}
                </fieldset>
              )
            }
            {vaultReady() ? (
              <div class="ms-tools">
                <button class="btn" type="submit">Save credentials</button>
                <a class="ms-text" href="/team/credentials">Cancel</a>
              </div>
            ) : (
              <p class="muted">Cannot save until encryption is configured.</p>
            )}
          </form>
        </section>
      )
    }

    <section>
      <h2 class="team-h2">Vault</h2>
      {
        credentials.length === 0 ? (
          <p class="muted">{admin ? 'Nothing stored yet.' : 'Nothing has been shared with you yet.'}</p>
        ) : (
          <ul class="team-list">
            {credentials.map((item) => (
              <li>
                <a href={`/team/credentials/${item.id}`}>
                  <strong>{item.title}</strong>
                  <span>
                    {item.website || 'No website'}
                    {isStaleCredential(item.updated_at) ? ` · not reviewed in ${CREDENTIAL_STALE_DAYS}+ days` : ''}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Team>
