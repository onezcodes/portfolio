---
import Team from '../../../layouts/Team.astro';
import TeamFlash from '../../../components/TeamFlash.astro';
import SecretField from '../../../components/SecretField.astro';
import {
  credentialPayload,
  decryptCredential,
  hasSecret,
  isSecretField,
  vaultReady,
  websiteHref,
  type CredentialRecord,
  type SecretField,
} from '../../../lib/credentials';
import { logEvent } from '../../../lib/events';
import { notifyVaultGrants } from '../../../lib/mail';
import { emailOf, isSuperAdmin, SUPER_ADMIN_EMAIL } from '../../../lib/supabase';
import type { TeamMember } from '../../../lib/ledger';

const studio = Astro.locals.studio;
const supabase = Astro.locals.supabase;
const admin = isSuperAdmin(Astro.locals.user);
const { id } = Astro.params;

if (!id) return Astro.redirect('/team/credentials');
if (!studio?.canVault) return Astro.redirect('/team?error=forbidden');

const actor = studio.email || emailOf(Astro.locals.user);
let revealed: SecretField | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'update');
  const base = `/team/credentials/${id}`;

  if (intent === 'reveal') {
    const field = String(form.get('field') ?? '');
    if (!isSecretField(field)) return Astro.redirect(`${base}?error=invalid`);
    revealed = field;
    await logEvent(supabase, actor, {
      action: 'reveal',
      entityType: 'credential',
      entityId: id,
      detail: field,
    });
  } else if (!admin) {
    return Astro.redirect(`${base}?error=forbidden`);
  } else if (intent === 'delete') {
    const { data: named } = await supabase.from('studio_credentials').select('title').eq('id', id).maybeSingle();
    const { error } = await supabase.from('studio_credentials').delete().eq('id', id);
    if (error) return Astro.redirect(`${base}?error=invalid`);
    await logEvent(supabase, actor, {
      action: 'delete',
      entityType: 'credential',
      entityId: id,
      detail: named?.title ?? '',
    });
    return Astro.redirect('/team/credentials?notice=deleted');
  } else if (intent === 'access') {
    const viewers = form
      .getAll('viewer')
      .map((value) => String(value).trim().toLowerCase())
      .filter((email) => email && email !== SUPER_ADMIN_EMAIL);
    const { data: prior } = await supabase.from('studio_credential_access').select('email').eq('credential_id', id);
    const before = new Set((prior ?? []).map((row) => row.email as string));
    const added = viewers.filter((email) => !before.has(email));
    const { error: clearError } = await supabase.from('studio_credential_access').delete().eq('credential_id', id);
    if (clearError) return Astro.redirect(`${base}?error=invalid`);
    if (viewers.length > 0) {
      const { error } = await supabase
        .from('studio_credential_access')
        .insert(viewers.map((email) => ({ credential_id: id, email })));
      if (error) return Astro.redirect(`${base}?error=invalid`);
    }
    const { data: named } = await supabase.from('studio_credentials').select('title').eq('id', id).maybeSingle();
    await logEvent(supabase, actor, {
      action: 'access',
      entityType: 'credential',
      entityId: id,
      detail: viewers.join(', ') || 'none',
    });
    if (added.length > 0) {
      const sent = await notifyVaultGrants(added, named?.title ?? 'studio credentials', Astro.request);
      return Astro.redirect(`${base}?notice=${sent === added.length ? 'granted' : 'granted-no-mail'}`);
    }
    return Astro.redirect(`${base}?notice=saved`);
  } else {
    if (!vaultReady()) return Astro.redirect(`${base}?error=vault-setup`);
    const { data: current } = await supabase.from('studio_credentials').select('*').eq('id', id).maybeSingle();
    if (!current) return Astro.redirect('/team/credentials?error=not-found');
    let payload: ReturnType<typeof credentialPayload>;
    try {
      payload = credentialPayload(form, current as CredentialRecord);
    } catch {
      return Astro.redirect(`${base}?error=vault-setup`);
    }
    if (!payload) return Astro.redirect(`${base}?error=invalid`);
    const { error } = await supabase.from('studio_credentials').update(payload).eq('id', id);
    if (error) return Astro.redirect(`${base}?error=invalid`);
    await logEvent(supabase, actor, {
      action: 'update',
      entityType: 'credential',
      entityId: id,
      detail: payload.title,
    });
    return Astro.redirect(`${base}?notice=saved`);
  }
}

const { data: row, error } = await supabase.from('studio_credentials').select('*').eq('id', id).maybeSingle();
if (error || !row) return Astro.redirect('/team/credentials?error=not-found');

const record = row as CredentialRecord;
const secrets = revealed ? decryptCredential(record) : null;
const site = websiteHref(record.website);

const [{ data: grantRows }, { data: memberRows }] = await Promise.all([
  supabase.from('studio_credential_access').select('email').eq('credential_id', id),
  admin ? supabase.from('team_members').select('*').order('email') : Promise.resolve({ data: [] }),
]);
const granted = new Set((grantRows ?? []).map((item) => item.email as string));
const members = ((memberRows ?? []) as TeamMember[]).filter((member) => member.email !== SUPER_ADMIN_EMAIL);
---

<Team title={record.title}>
  <div class="wrap team-page">
    <header class="team-intro">
      <p class="kicker"><a href="/team/credentials">Credentials</a></p>
      <h1>{record.title}</h1>
      <p class="lede">
        {
          site ? (
            <a href={site} target="_blank" rel="noopener noreferrer">
              {record.website}
            </a>
          ) : (
            'No website recorded'
          )
        }
      </p>
    </header>
    <TeamFlash />

    <section class="team-card">
      <h2>Secrets</h2>
      <p class="muted">Secrets stay hidden until you reveal them. Each reveal is written to Activity.</p>
      <SecretField id="view_username" label="Username" value={record.username} />
      <SecretField id="view_login_email" label="Login email" value={record.login_email} />
      <SecretField
        id="view_password"
        label="Password"
        revealField="password"
        hasValue={hasSecret(record, 'password')}
        revealed={revealed === 'password'}
        value={secrets?.password}
      />
      <SecretField
        id="view_api_key"
        label="API key"
        revealField="api_key"
        hasValue={hasSecret(record, 'api_key')}
        revealed={revealed === 'api_key'}
        value={secrets?.api_key}
      />
      <SecretField
        id="view_api_token"
        label="API token"
        revealField="api_token"
        hasValue={hasSecret(record, 'api_token')}
        revealed={revealed === 'api_token'}
        value={secrets?.api_token}
      />
      <SecretField
        id="view_notes"
        label="Notes"
        revealField="notes"
        hasValue={hasSecret(record, 'notes')}
        revealed={revealed === 'notes'}
        value={secrets?.notes}
        multiline
      />
    </section>

    {
      admin && (
        <>
          <section class="team-card">
            <h2>Who can view</h2>
            <form class="form team-form" method="post">
              <input type="hidden" name="intent" value="access" />
              {
                members.length === 0 ? (
                  <p class="muted">Whitelist teammates first, then grant access here.</p>
                ) : (
                  <fieldset class="role-picks">
                    <legend class="muted">Team members</legend>
                    {members.map((member) => (
                      <label>
                        <input type="checkbox" name="viewer" value={member.email} checked={granted.has(member.email)} />
                        <span>{member.email}</span>
                      </label>
                    ))}
                  </fieldset>
                )
              }
              <button class="btn" type="submit">Save access</button>
            </form>
          </section>

          <section class="team-card">
            <h2>Edit</h2>
            <p class="muted">Leave a secret blank to keep the stored value.</p>
            <form class="form team-form" method="post">
              <input type="hidden" name="intent" value="update" />
              <p class="field">
                <label for="title">Name</label>
                <input id="title" name="title" required value={record.title} />
              </p>
              <p class="field">
                <label for="website">Website</label>
                <input id="website" name="website" value={record.website} />
              </p>
              <div class="team-form-row">
                <p class="field">
                  <label for="username">Username</label>
                  <input id="username" name="username" value={record.username} autocomplete="off" />
                </p>
                <p class="field">
                  <label for="login_email">Login email</label>
                  <input id="login_email" name="login_email" type="email" value={record.login_email} autocomplete="off" />
                </p>
              </div>
              <p class="field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" placeholder="Unchanged" />
              </p>
              <p class="field">
                <label for="api_key">API key</label>
                <input id="api_key" name="api_key" autocomplete="off" placeholder="Unchanged" />
              </p>
              <p class="field">
                <label for="api_token">API token</label>
                <input id="api_token" name="api_token" autocomplete="off" placeholder="Unchanged" />
              </p>
              <p class="field">
                <label for="notes">Notes</label>
                <textarea id="notes" name="notes" rows="3" placeholder="Unchanged"></textarea>
              </p>
              <button class="btn" type="submit">Save changes</button>
            </form>
            <form class="team-danger" method="post" onsubmit="return confirm('Delete these credentials?')">
              <input type="hidden" name="intent" value="delete" />
              <button class="btn btn-ghost" type="submit">Delete</button>
            </form>
          </section>
        </>
      )
    }
  </div>
</Team>
