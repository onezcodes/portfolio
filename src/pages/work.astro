---
export const prerender = true;

import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { projects } from '../data/site';
import { pages } from '../data/seo';
---

<Base title={pages.work.title} description={pages.work.description}>
  <header class="page-intro wrap">
    <p class="kicker">Work</p>
    <h1>Projects with a measurable after</h1>
    <p class="lede">Final Third Zone and SayDiagram are live. Lumiere’s site is up, and the app is still on the way.</p>
  </header>

  <section class="section" aria-label="Project list">
    <div class="wrap work-list">
      {projects.map((project, index) => <WorkCard project={project} index={index} />)}
    </div>
  </section>
</Base>
