---
export const prerender = true;

import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, brief } from '../data/site';
import { pages } from '../data/seo';
---

<Base title={pages.contact.title} description={pages.contact.description}>
  <header class="page-intro wrap">
    <p class="kicker">Contact</p>
    <h1>Get in touch</h1>
    <p class="lede">A few sentences are enough: the product, the constraint, and the date that matters.</p>
  </header>

  <section class="section">
    <div class="wrap contact-split">
      <div class="contact-details">
        <p class="lede">We usually reply within two working days.</p>
        <address>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <p>{site.location}</p>
        </address>
        <ul class="social-links">
          {
            site.social.map((item) => (
              <li>
                <a href={item.href} rel="me noopener noreferrer" target="_blank">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div>
          <h3 class="sector">What to send</h3>
          <ul class="deliverables">
            {brief.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
